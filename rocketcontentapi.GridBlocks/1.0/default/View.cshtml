@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->
@{
    var cssClass = "";
    if (moduleData.GetSetting("cssclass") != "")
    {
        cssClass = "class=" + moduleData.GetSetting("cssclass");
    }
}

<div @(cssClass)>

    <div class="grid-wrapper">

        [INJECT:appthemesystem,ArticleHeaderView.cshtml]

        <div class="grid-refs">
            <div class="grid-sizer"></div>
            @foreach (var articleRowData in articleData.GetRows())
            {
                var hideRow = info.GetXmlPropertyBool("genxml/checkbox/hiderow");
                if (!hideRow)
                {
                    var gridsize = articleRowData.Info.GetXmlProperty("genxml/select/gridsize");
                    var articleImage = articleRowData.GetImage(0);
                    var cssClassRow = "";
                    if (info.GetXmlProperty("genxml/textbox/cssclass") != "")
                    {
                        cssClassRow = info.GetXmlProperty("genxml/textbox/cssclass");
                    }
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 0)
                    {
                        <div class="grid-item grid-item@(gridsize) @(cssClassRow)">
                            <div class="refsimg" style="background-image:url('@ImageUrl(articleImage.RelPath, "", "")');">
                                <div class="refsoverlay"><h4>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h4></div>
                                <div class="refstext">
                                    <h3>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h3>
                                    <p>@info.GetXmlProperty("genxml/lang/genxml/textbox/title2")</p>
                                </div>
                            </div>
                        </div>
                    }
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
                    {
                        var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
                        var anchor = "";
                        if (info.GetXmlProperty("genxml/lang/genxml/textbox/linkanchor") != "")
                        {
                            anchor = "#" + info.GetXmlProperty("genxml/lang/genxml/textbox/linkanchor");
                        }
                        <a class="grid-item grid-item@(gridsize) @(cssClassRow)" href="@(tabddlvalue)@(anchor)">
                            <div class="refsimg" style="background-image:url('@ImageUrl(articleImage.RelPath, "", "")');">
                                <div class="refsoverlay">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</div>
                                <div class="refstext">
                                    <h3 class="refstext-line1">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h3>
                                    <h4 class="refstext-line2">@info.GetXmlProperty("genxml/lang/genxml/textbox/title2")</h4>
                                </div>
                            </div>
                        </a>
                    }
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
                    {
                        var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
                        <a class="grid-item grid-item@(gridsize) @(cssClassRow)" href="@(externalURL)" target="_blank">
                            <div class="refsimg" style="background-image:url('@ImageUrl(articleImage.RelPath, "", "")');">
                                <div class="refsoverlay">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</div>
                                <div class="refstext">
                                    <h3 class="refstext-line1">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h3>
                                    <h4 class="refstext-line2">@info.GetXmlProperty("genxml/lang/genxml/textbox/title2")</h4>
                                </div>
                            </div>
                        </a>
                    }
                }
            }
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Isotope
        var $grid = $('.grid-refs').isotope({
            itemSelector: '.grid-item',
            percentPosition: true,
            masonry: {
                columnWidth: '.grid-sizer'
            }
        });
        // Overlap fix
        $grid.imagesLoaded().progress(function () {
            $grid.isotope('layout');
        });
    });
</script>