@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketContentAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
}

@foreach (var articleRowData in articleData.GetRows())
{
    var info = articleRowData.Info;
    var articleImage = articleRowData.GetImage(0);
    var cssClass = "";
    if (moduleData.GetSetting("cssclass") != "")
    {
        cssClass = "class=" + moduleData.GetSetting("cssclass") + "";
    }
    <div @(cssClass)>
        <div class="about-content">
            <img src="@ImageUrl(articleImage.RelPath, moduleData.GetSettingInt("width"), moduleData.GetSettingInt("height"))" />
            @if (info.GetXmlProperty("genxml/lang/genxml/textbox/content") != "")
            {
                <div class="about-text">
                    @info.GetXmlProperty("genxml/lang/genxml/textbox/content")
                </div>
            }
            [INJECT:appthemesystem,ArticleLinksView.cshtml]
        </div>
    </div>
}


