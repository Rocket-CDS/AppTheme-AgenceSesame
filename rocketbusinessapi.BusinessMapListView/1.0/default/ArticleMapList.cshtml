@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;

@{
    var sessionParams = (SessionParams)Model.SessionParamsData;
    var articleDataList = (ArticleLimpetList)Model.GetDataObject("articlelist");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var categoryList = (CategoryLimpetList)Model.GetDataObject("categorylist");
    var appTheme = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeDefault = (AppThemeLimpet)Model.GetDataObject("appthemedefault");
    var appThemeDirectory = (AppThemeSystemLimpet)Model.GetDataObject("appthemedirectory");
    var appThemeDirectoryDefault = (AppThemeLimpet)Model.GetDataObject("appthemedirectorydefault");
    var categoryData = (CategoryLimpet)Model.GetDataObject("categorydata");
    var catalogSettings = (CatalogSettingsLimpet)Model.GetDataObject("catalogsettings");
    var propertyList = (PropertyLimpetList)Model.GetDataObject("propertylist");
    var moduleSettings = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var propertyCheckboxes = new List<PropertyLimpet>();
    var nodList = false;
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");

    AddProcessDataResx(appThemeView, true);
}
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")


<div class="container">

    <h1 class="title">@ResourceKey("BusinessMapListView.restaurants", sessionParams.CultureCode)</h1>

                @if (articleDataList.GetArticleList().Count > 0)
                {
                if (!sessionParams.GetBool("mapdisplay" + Model.SessionParamsData.ModuleId))
                {
                    <div class="listviews">
                <a href="javascript:void(0);" onclick="simplisity_setParamField('mapdisplay@(Model.SessionParamsData.ModuleId)','True');location.reload();"><i class="fas fa-map-marker-alt"></i>@ResourceKey("BusinessMapListView.mapview", sessionParams.CultureCode)</a>
                    </div>
                    <div class="listcontainer">
                        <div class="productlist">

                            @foreach (ArticleLimpet articleData in articleDataList.GetArticleList())
                            {
                                var urlparams = new Dictionary<string, string>();
                                urlparams.Add("articleid", articleData.ArticleId.ToString());
                                var hreflink = DNNrocketUtils.NavigateURL(sessionParams.TabId, urlparams, articleData.Name);

                                <div class="product">
                                    <div class="product-image">
                                <a href="@(hreflink)" title="@articleData.Name" onclick="$('#simplisity_loader').show();">
                                            <img src="@ThumbnailImageWebsiteDomainUrl(portalData.EngineUrlWithProtocol,articleData.GetImage(0).RelPath,380, 285)" alt="@articleData.GetImage(0).Alt" />
                                        </a>
                                    </div>
                                    <div class="product-content">
                                        <h2><a href="@(hreflink)" title="@articleData.Name" onclick="$('#simplisity_loader').show();">@articleData.Name</a></h2>
                                        <div class="product-summary">
                                            @articleData.Info.GetXmlProperty("genxml/textbox/address1")
                                            @if (articleData.Info.GetXmlProperty("genxml/textbox/address2") != "")
                                            {
                                                <br /><span>@articleData.Info.GetXmlProperty("genxml/textbox/address2")</span>
											}
                                            @if (articleData.Info.GetXmlProperty("genxml/textbox/address3") != "")
                                            {
                                                <br /><span>@articleData.Info.GetXmlProperty("genxml/textbox/address3")</span>
											}
                                            @if (articleData.Info.GetXmlProperty("genxml/textbox/address4") != "")
                                            {
                                                <br /><span>@articleData.Info.GetXmlProperty("genxml/textbox/address4")</span>
											}
											@if (articleData.Info.GetXmlProperty("genxml/textbox/phone") != "")
											{
												var clictel = articleData.Info.GetXmlProperty("genxml/textbox/mobile");
                                        <br />

                                        @ResourceKey("BusinessMapListView.tel", sessionParams.CultureCode) <a href="tel:@clictel">@articleData.Info.GetXmlProperty("genxml/textbox/phone")</a>
											}	
                                        </div>
                                <a href="@(hreflink)" title="@articleData.Name" onclick="$('#simplisity_loader').show();" class="bigbutton detailbtn">@ResourceKey("BusinessMapListView.details", sessionParams.CultureCode)</a>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                    <div class="w3-row w3-padding-16 w3-center">
                        @RenderTemplate("ProductPaging.cshtml", appThemeDirectoryDefault, Model, true)
                    </div>

                }
                else
                {
                    <div class="listviews">
                <a href="javascript:void(0);" onclick="simplisity_setParamField('mapdisplay@(Model.SessionParamsData.ModuleId)','False');location.reload();"><i class="fas fa-th-list"></i>@ResourceKey("BusinessMapListView.listview", sessionParams.CultureCode)</a>
                    </div>

                    <div class="mapcontainer">

                <div id="leafletmap" style="width:@(moduleSettings.GetSetting("mapwidth"));height:@(moduleSettings.GetSetting("mapheight"));"></div>

                        @{ var locationlist = "";
                            var boundlocationlist = "";
                            var gpslong = "";
                            var gpslat = "";
                            var companyname = "";
                            var websiteurl = "";
                            var txtdata = "";
                            var articlesummary = "";
                            ArticleImage articleImage = null;
                            var detailpageurl = ""; }

                        @foreach (ArticleLimpet articleData in articleDataList.GetArticleList())
                        {
                            var info = articleData.Info;
                            gpslong = info.GetXmlProperty("genxml/textbox/long").Replace("'", "");
                            gpslat = info.GetXmlProperty("genxml/textbox/lat").Replace("'", "");
                            companyname = info.GetXmlProperty("genxml/lang/genxml/textbox/articlename").Replace("'", "-");
                            articleImage = articleData.GetImage(0);
                            detailpageurl = "";

                            if (GeneralUtils.IsNumeric(gpslong) && (GeneralUtils.IsNumeric(gpslat)))
                            {
                                var mapIcon = "defaultIcon";

                                txtdata = "'<div class=\"leafletinfowindow liwimg\" style=\"overflow: hidden;\">";
                                if (articleImage != null && articleImage.RelPath != "")
                                {
                                    txtdata += "<img src=\"" + ThumbnailImageUrl(portalData.EngineUrlWithProtocol, articleImage.RelPath, 200, 150) + "\"/>";
                                }
                                txtdata += "<h3><a href=\"?articleid=" + articleData.ArticleId + "&" + GeneralUtils.UrlFriendly(articleData.Name) + "\">" + companyname + "</a></h3>";
                                txtdata += "</div>'";

                                locationlist += "var m = L.marker([" + gpslat + ", " + gpslong + "], {icon: " + mapIcon + ",itemid: " + info.ItemID + "}, { title: '" + companyname + "' }, {itemid: " + info.ItemID + "});";
                                locationlist += "m.bindPopup(" + txtdata + ").openPopup();";
                                locationlist += "m.number = " + info.ItemID + ";";
                                locationlist += "markers1.addLayer(m);";
                                boundlocationlist += "L.marker([" + gpslat + ", " + gpslong + "]),";
                            }
                        }

                        <script>

    $(document).ready(function () {
        setTimeout(() => { initmap(); }, 200);
    });

    function initmap() {
        var defaultIcon = L.icon({
            iconUrl: location.protocol + '//' + location.host + '@("/" + appThemeView.AppThemeVersionFolderRel)/img/marker-default.png',
			iconSize: [27, 36],
			iconAnchor: [13, 36]
        });

        //set grouping markers maxClusterRadius: 80 is the default option, can change to reduce splitting on zoom
        var markers1 = L.markerClusterGroup();

        var map = L.map('leafletmap', {
            scrollWheelZoom: false
        });

        var tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        //set the initial padding of the map depending on markers position
        var boundmarkers = [@(new RazorEngine.Text.RawString(boundlocationlist.TrimEnd(',')))];

        if (boundmarkers.length > 0)
        {
            var group = L.featureGroup(boundmarkers);
            map.fitBounds(group.getBounds(), {
        	    padding: [100, 100]
            })
        }

        @(new RazorEngine.Text.RawString(locationlist))

        // add markers layer
        map.addLayer(markers1);
        map.on('focus', function() { map.scrollWheelZoom.enable(); });
        map.on('blur', function () { map.scrollWheelZoom.disable(); });

    }

                        </script>

                    </div>
                }

}
else
{
    <div class="h2-headline">Aucun résultat</div>
}

</div>

<script>
$(document).ready(function () {        
});
</script>