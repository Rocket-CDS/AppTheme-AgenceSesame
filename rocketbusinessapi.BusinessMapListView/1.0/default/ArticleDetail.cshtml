@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")


@functions {

    public string DisplayOpenTime(string dayName, string open1, string close1, string open2, string close2)
    {
        var rtn = "";
        rtn += "<th>" + dayName + "</th>";

        // Open1
        var rtnOpen1 = "";
        if (open1 == "" && close1 == "")
        {
            rtnOpen1 += "<td>" + ResourceKey("BusinessMapListView.closed").ToString() + "</td>";
        }
        if (open1 != "" && close1 != "")
        {
            rtnOpen1 += "<td>" + open1 + " - " + close1 + "</td>";
        }
        if (open1 != "" && close1 == "")
        {
            rtnOpen1 += "<td>" + open1 + "</td>";
        }
        //Open1 Default
        if (rtnOpen1 == "")
        {
            rtnOpen1 += "<td>" + ResourceKey("BusinessMapListView.closed").ToString() + "</td>";
        }

        // Open2
        var rtnOpen2 = "";
        if (open2 == "" && close2 == "")
        {
            rtnOpen2 += "<td>" + ResourceKey("BusinessMapListView.closed").ToString() + "</td>";
        }
        if (open2 != "" && close2 != "")
        {
            rtnOpen2 += "<td>" + open2 + " - " + close2 + "</td>";
        }
        if (open2 == "" && close2 != "")
        {
            rtnOpen2 += "<td>" + close2 + "</td>";
        }
        //Open2 Default
        if (rtnOpen2 == "")
        {
            rtnOpen2 += "<td>" + ResourceKey("BusinessMapListView.closed").ToString() + "</td>";
        }

        rtn += rtnOpen1;
        rtn += rtnOpen2;

        return rtn;
    }

}

<div class="productdetail">

