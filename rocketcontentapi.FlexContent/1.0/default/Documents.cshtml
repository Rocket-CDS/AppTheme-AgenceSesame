@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{ var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
                var articleRow = (ArticleRowLimpet)Model.GetDataObject("articlerow");
                var info = articleRow.Info;
}

@foreach (var docInfo in articleRow.GetDocList())
{
    var docURL = docInfo.GetXmlProperty("genxml/hidden/documentpatharticledoc");
    <!-- Si on veut afficher le pdf sur un nouvel onglet alors on l'affiche '-->
    if (docInfo.GetXmlPropertyBool("genxml/checkbox/openinnewtab"))
    {
        <div class="documents">
            <a href="@(docURL)" target="_blank">
                @if (docInfo.GetXmlProperty("genxml/lang/genxml/textbox/name") != "")
                {
                    @docInfo.GetXmlProperty("genxml/lang/genxml/textbox/name")
                }
                else
                {
                    @docInfo.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                }
            </a>
        </div>
    }
    else
    {
        <div class="documents">
            <a href="@(docURL)" download>
                @if (docInfo.GetXmlProperty("genxml/textbox/name") != "")
                {
                    @docInfo.GetXmlProperty("genxml/lang/genxml/textbox/name")
                }
                else
                {
                    @docInfo.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                }
            </a>
        </div>
    }
}
