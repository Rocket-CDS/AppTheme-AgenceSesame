@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleRow = (ArticleRowLimpet)Model.GetDataObject("articlerow");
    var info = articleRow.Info;
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
}
<div class="flexcontent-div @info.GetXmlProperty("genxml/textbox/cssclass")">
    <div class="flexcontent-text">
        @{
            var layout = info.GetXmlPropertyInt("genxml/select/layout");
            var hStyle = info.GetXmlProperty("genxml/select/headingstyle");
            var headingHide = info.GetXmlPropertyBool("genxml/checkbox/hideheading");
        }
        <!-- HEADING SECTION -->        
        @if (!headingHide)
        {
            var title = info.GetXmlProperty("genxml/lang/genxml/textbox/title");
            var headingalignvalue = info.GetXmlPropertyInt("genxml/select/headingalign");
            var headingalign = "";
            if (headingalignvalue == 1)
            {
                headingalign = "w3-center";
            }
            if (headingalignvalue == 2)
            {
                headingalign = "w3-right";
            }

            if (hStyle == "")
            {
                hStyle = "h1";
            }
            if (title != "")
            {
                var alignText = info.GetXmlProperty("genxml/select/headingalign");
                if (hStyle.ToLower() == "h1")
                {
                    <h1 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@title</h1>
                }
                if (hStyle.ToLower() == "h2")
                {
                    <h2 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@title</h2>
                }
                if (hStyle.ToLower() == "h3")
                {
                    <h3 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@title</h3>
                }
                if (hStyle.ToLower() == "h4")
                {
                    <h4 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@title</h4>
                }
            }
        }

        <!-- TEXT SECTION -->
        @HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))

        <!-- LINK SECTION -->
        <div class="newspaper-link">
            @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
            {
                var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
                <a href="@(tabddlvalue)#@info.GetXmlProperty("genxml/textbox/linkanchor")">@info.GetXmlProperty("genxml/lang/genxml/textbox/linktitle")</a>
            }
            @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
            {
                var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
                var blank = "";
                if (@info.GetXmlPropertyBool("genxml/checkbox/blank"))
                {
                    blank = "_blank";
                }
                <a href="@(externalURL)" target="@(blank)">@info.GetXmlProperty("genxml/lang/genxml/textbox/linktitle")</a>
            }
        </div>

        <!-- DOCUMENTS SECTION -->
        @RenderTemplate("documents.cshtml", moduleData.ModuleRef, appThemeView, Model, true)
    </div>
</div>
