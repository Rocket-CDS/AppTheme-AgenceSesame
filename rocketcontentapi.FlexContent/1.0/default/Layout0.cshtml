@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@AssigDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

<div class="flexcontent-div @info.GetXmlProperty("genxml/lang/genxml/textbox/cssclass")">
<div class="flexcontent-text">
        [INJECT:appthemesystem,ArticleRowHeaderView.cshtml]
        @HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))
        @HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/htmltext"))
        <div class="newspaper-link">
            @RenderTemplate("Links.cshtml", moduleData.ModuleRef, appThemeView, Model, true)
        </div>
        <div class="documents">
            @RenderTemplate("Documents.cshtml", moduleData.ModuleRef, appThemeView, Model, true)
        </div>
    </div>
</div>
