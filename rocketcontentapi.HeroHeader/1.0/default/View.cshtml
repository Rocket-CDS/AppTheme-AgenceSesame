@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");

    var cssClass = "";
    var mask = "";
    if (moduleData.Record.GetXmlProperty("genxml/setting/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass");
    }

    if (moduleData.Record.GetXmlPropertyBool("genxml/settings/mask"))
    {
        mask = "tih-mask";
    }

    var crop = moduleData.Record.GetXmlProperty("genxml/settings/crop");
}

@foreach (var articleRowData in articleData.GetRows())
{
    var info = articleRowData.Info;
    var datalist = articleRowData.GetImageList();
    var imgInfo = datalist.First();
    var articleImage = new ArticleImage(imgInfo, "articleimage");

    var width = moduleData.Record.GetXmlPropertyInt("genxml/settings/width");
    var height = moduleData.Record.GetXmlPropertyInt("genxml/settings/height");
    var separationLine = moduleData.Record.GetXmlPropertyBool("genxml/settings/separation");
    <div @(cssClass)>
        @if (!info.GetXmlPropertyBool("genxml/checkbox/hiderow"))
        {
            <div class="topimageheader @(mask)" style="background:url('@ImageUrl(articleImage.RelPathWebp, width, height, "", "webp")') center @(crop) no-repeat;
                                                    -webkit-background-size: cover;
                                                    -moz-background-size: cover;
                                                    -o-background-size: cover;
                                                    background-size: cover;">
                <div class="caption">
                    <h2>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>
                    @if (separationLine)
                    {
                        <hr />
                    }
                    <h3>@BreakOf(info, "genxml/lang/genxml/textbox/text")</h3>
                </div>
            </div>

        }
    </div>


}


