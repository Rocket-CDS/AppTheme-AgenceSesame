@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appThemeAdmin, true)
<!--inject-->
<!-- require Key for saving -->
@RowKey(rowData)

@{
    var hidecssclass = "";
    if (!UserUtils.IsAdministrator())
    {
        hidecssclass = " w3-hide ";
    }
}

<div class='w3-row w3-padding'>

    <div class='w3-third w3-margin-bottom @(hidecssclass)' style='min-width: 200px;'>
        <label>@ResourceKey("DNNrocket.cssClass")</label>
        @TextBox(info, "genxml/textbox/cssclass", "class='w3-input w3-border' autocomplete='off'", "", true, 0)
    </div>

    [INJECT:appthemesystem,ArticleLinks.cshtml]

</div>



