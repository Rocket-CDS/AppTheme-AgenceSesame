@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->
@{
    var cssClass = "";
    if (moduleData.GetSetting("cssclass") != "")
    {
        cssClass = "class=" + moduleData.GetSetting("cssclass");
    }
}

<div @(cssClass)>

    <div class="gblockswrapper">

        [INJECT:appthemesystem,ArticleHeaderView.cshtml]

        <div class="gblocks">
            @foreach (var articleRowData in articleData.GetRows())
            {
                Model.SetDataObject("articlerow", articleRowData);
                var info = articleRowData.Info;
                var hideRow = info.GetXmlPropertyBool("genxml/checkbox/hiderow");
                var articleImage = articleRowData.GetImage(0);
                var width = moduleData.Record.GetXmlPropertyInt("genxml/settings/width");
                var height = moduleData.Record.GetXmlPropertyInt("genxml/settings/height");

                if (!hideRow)
                {
                    var cssClassRow = "";
                    if (info.GetXmlProperty("genxml/textbox/cssclass") != "")
                    {
                        cssClassRow = info.GetXmlProperty("genxml/textbox/cssclass");
                    } 
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 0)
                    {
                        <div class="gblock @(cssClassRow)">
                            <img src="@ImageUrl(articleImage.RelPath, width, height)" alt="@info.GetXmlProperty("genxml/lang/genxml/textbox/title")" />
                            @{
                                var title = info.GetXmlProperty("genxml/lang/genxml/textbox/title");
                            }
                            <div class="gblockstext">
                                <h2>@title</h2>
                                <h3>@info.GetXmlProperty("genxml/lang/genxml/textbox/text")</h3>
                            </div>
                        </div>
                    }
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
                    {
                        var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
                        var anchor = "";
                        if (info.GetXmlProperty("genxml/lang/genxml/textbox/linkanchor") != "")
                        {
                            anchor = "#" + info.GetXmlProperty("genxml/lang/genxml/textbox/linkanchor");
                        }
                        <a class="gblock @(cssClassRow)" href="@(tabddlvalue)@(anchor)">
                            <img src="@ImageUrl(articleImage.RelPath, width, height)" alt="@info.GetXmlProperty("genxml/lang/genxml/textbox/title")" />
                            @{
                                var title = info.GetXmlProperty("genxml/lang/genxml/textbox/title");
                            }
                            <div class="gblockstext">
                                <h2>@title</h2>
                                <h3>@info.GetXmlProperty("genxml/lang/genxml/textbox/text")</h3>
                            </div>
                        </a>
                    }
                    if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
                    {
                        var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
                        <a class="gblock @(cssClassRow)" href="@(externalURL)" target="_blank">
                            <img src="@ImageUrl(articleImage.RelPath, width, height)" alt="@info.GetXmlProperty("genxml/lang/genxml/textbox/title")" />
                            @{
                                var title = info.GetXmlProperty("genxml/lang/genxml/textbox/title");
                            }
                            <div class="gblockstext">
                                <h2>@title</h2>
                                <h3>@info.GetXmlProperty("genxml/lang/genxml/textbox/text")</h3>
                            </div>
                        </a>
                    }
                }
            }
        </div>
    </div>
</div>