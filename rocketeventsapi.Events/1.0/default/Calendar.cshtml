@inherits RocketEventsAPI.Components.RocketEventsAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using Simplisity;
@using RocketEventsAPI.Components;
@using System.Globalization;
@AssigDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->
<div id="calmonthwrapper@(moduleData.ModuleId)" class="events-calendar">
    [INJECT:apptheme,CalendarDisplay.cshtml]
</div>

<div id="calmonthdetailmodel@(moduleData.ModuleId)" class="w3-modal w3-animate-opacity">
    <div class="w3-modal-content calendar-popup" style="width:40%;">
        <header>
            <span onclick="$('#calmonthdetailmodel@(moduleData.ModuleId)').hide();" class="w3-button w3-display-topright">&times;</span>
        </header>
        <div id="calmonthdetailcontainer@(moduleData.ModuleId)" class="calendarlist">
            [INJECT:apptheme,CalendarEventList.cshtml]
        </div>
    </div>
</div>

<script>
    function getMonthCalendarDetail(d) {
        $('.a-dayselect').hide();
        $('.a-day' + d).show();
        $('#calmonthdetailmodel@(moduleData.ModuleId)').show();
    }
    function showcalmonthdetailmodel@(moduleData.ModuleId)() {
        $('#calmonthdetailmodel@(moduleData.ModuleId)').show();
        $('#calmonth@(moduleData.ModuleId)').css({ 'opacity': 1 });
    }
</script>

