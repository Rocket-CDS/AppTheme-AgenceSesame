@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appTheme, true)
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")
<!--inject-->
@{
    var articleList = articleDataList.GetArticleList(moduleData);
    var widthlist = moduleData.GetSettingInt("widthlist");
    var heightlist = moduleData.GetSettingInt("heightlist");
}

<div class="events-sat">

    <div class="h2-headline">@ResourceKey("Events.events")</div>

    <div class="events">
        @foreach (ArticleLimpet article in articleList)
        {
            var urlparams = new Dictionary<string, string>();
            urlparams.Add("articleid", article.ArticleId.ToString());
            <article>
                @if (article.GetImage(0).RelPathWebp != "")
                {
                    <figure><a href="@DetailUrl(moduleData.DetailPageTabId(), article, categoryData)" onclick="$('#simplisity_loader').show();"><img src="@ImageUrl(article.GetImage(0).RelPathWebp, widthlist, heightlist)" alt="@article.GetImage(0).Alt" /></a></figure>                 
                }
                <div class="eventdate">
                    <span class="ed-day">@DateOf(article.Info, "genxml/textbox/eventstartdate", sessionParams.CultureCode, "dd")</span>
                    <span class="ed-month">@DateOf(article.Info, "genxml/textbox/eventstartdate", sessionParams.CultureCode, "MMM")</span>
                    <span class="ed-year">@DateOf(article.Info, "genxml/textbox/eventstartdate", sessionParams.CultureCode, "yyy")</span>
                </div>
                <div class="article-content">
                    <h3><a href="@DetailUrl(moduleData.DetailPageTabId(), article, categoryData)" onclick="$('#simplisity_loader').show();">@article.Name</a></h3>
                    <div class="article-summary">
                        @article.Summary
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="eventssatlink">
        <a href="@ListUrl(moduleData.ListPageTabId(), categoryData)" class="bigbutton">@ResourceKey("Events.allevents")</a>
    </div>

</div>