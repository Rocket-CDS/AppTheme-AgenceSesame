@inherits RocketEventsAPI.Components.RocketEventsAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using Simplisity;
@using RocketEventsAPI.Components;
@using System.Globalization;
@AssigDataModel(Model)
@AddProcessDataResx(appTheme, true)
@{
    var articleDay = (Dictionary<int, List<ArticleLimpet>>)Model.GetDataObject("eventlistbyday");
}
<!--inject-->
@foreach (var articleListDict in articleDay)
{
    var keyclass = "a-day" + articleListDict.Key;
    var articleList2 = articleListDict.Value;

    <div class="events-table a-dayselect @(keyclass)">
        <h2>@monthStartDate.AddDays(articleListDict.Key - 1).ToString("D", new CultureInfo(sessionParams.CultureCode))</h2>
        @foreach (var articleData in articleList2)
        {
            var eventDate = articleData.Info.GetXmlPropertyDate("genxml/textbox/eventstartdate");
            <div class="events-table-item">
                <figure><img src="@ImageUrl(articleData.GetImage(0).RelPath, 60, 0)" alt="@articleData.Name" /></figure>
                <div>
                    <h3><a href="@DetailUrl(moduleData.DetailPageTabId(), articleData, categoryData)" onclick="$('#simplisity_loader').show();">@articleData.Name</a></h3>
                    @Succinct(articleData.Summary, 120)
                </div>
            </div>
        }
    </div>
}
