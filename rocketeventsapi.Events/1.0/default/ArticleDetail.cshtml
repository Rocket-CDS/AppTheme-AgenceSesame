@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")
<!--inject-->

@{
    var mainImage = articleData.GetImage(0);
    var widthdetail = moduleData.GetSettingInt("widthdetail");
    var heightdetail = moduleData.GetSettingInt("heightdetail");
}

<div class="event-detail">

    <div class="eventstools">
        <a href="@ListUrl(moduleData.ListPageTabId(), listUrlParams)" title="@ResourceKey("DNNrocket.back")"><span class="material-icons-outlined">home</span></a>
    </div>

    <article>

        <header>
            <h1>@articleData.Name</h1>
            <div class="eventdaterange">
                @ResourceKey("RocketEventsAPI.eventdate") : 
                <strong>@DateOf(articleData.Info, "genxml/textbox/eventstartdate", sessionParams.CultureCode, "dd/MM/yyy")
                @if (!articleData.Info.GetXmlPropertyBool("genxml/checkbox/alldayevent"))
                {
                    <span class="material-icons-outlined">schedule</span> @DateOf(articleData.Info, "genxml/textbox/eventstarttime", sessionParams.CultureCode, "HH:mm")
                }
                @if (articleData.Info.GetXmlProperty("genxml/textbox/eventstartdate") != articleData.Info.GetXmlProperty("genxml/textbox/eventenddate"))
                {
                    <span> - </span>@DateOf(articleData.Info, "genxml/textbox/eventenddate", sessionParams.CultureCode, "dd/MM/yyy")
                }
                @if (!articleData.Info.GetXmlPropertyBool("genxml/checkbox/alldayevent"))
                {
                    <span class="material-icons-outlined">schedule</span> @DateOf(articleData.Info, "genxml/textbox/eventendtime", sessionParams.CultureCode, "HH:mm")
                }
                </strong>
            </div>
        </header>

        @if (articleData.GetImages().Count > 0)
        {
        <figure>
            <picture>
				<a data-fancybox="group@(articleData.ArticleId)" data-caption="@(mainImage.Alt)" href="@ImageUrl(mainImage.RelPath,0,0)">
                    <img src="@ImageUrl(mainImage.RelPath, widthdetail, heightdetail)" alt="@(mainImage.Alt)" />
                </a>
            </picture>
        </figure>
        }

        <div class="article-flex">
            <div class="article-content">

                <p><strong>@articleData.Summary</strong></p>
                @HtmlOf(articleData.RichText)
                @HtmlOf(articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/htmltext"))

                @if (articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/video") != "")
                {
                    <div class="article-video"><div class="video-container">@HtmlOf(articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/video"))</div></div>
                }

                @if (articleData.GetLinkList().Count() > 0) 
                {
                <div class="article-links newspaper-link">
                    @foreach (var linkData in articleData.Getlinks())
                    {    
                        if (!linkData.Hidden)
                        {
                            <div><a href="@(linkData.Url)" target="@(linkData.Target)">@linkData.Name</a></div>
                        }
                    }
                </div>
                }
                @if (articleData.GetDocList().Count() > 0) {
                <div class="article-docs documents">
                    @foreach (ArticleDoc documentData in articleData.GetDocs())
                    {
                        if (!documentData.Hidden)
                        {
                            <div><a href="@(documentData.RelPath)" target="_blank" >@documentData.Name</a></div>
                        }
                    }
                    
                </div>
                }
            </div>
            <div class="article-infos">
				<div class="share-buttons">
                    <div class="bloginfo">@ResourceKey("DNNrocket.share")</div>
                    <div id="rocket-sharrre"></div>
                </div>
                <div class="eventinfo">@DateOf(articleData.Info, "genxml/textbox/eventstartdate", sessionParams.CultureCode, "dddd dd MMMM yyyy")</div>
            </div>
        </div>
        
        <hr />

        @if (articleData.GetImages().Count > 1)
        {
        <div class="article-gallery">
            @foreach (var articleImage in articleData.GetImages())
            {
                <a data-fancybox="group@(articleData.ArticleId)" data-caption="@(articleImage.Alt)" href="@ImageUrl(articleImage.RelPath,0,0)">
                    <img src="@ImageUrl(articleImage.RelPath, 120, 120)" alt="@(articleImage.Alt)" />
                </a>
            }
        </div>
        }

    </article>

</div>

<script type="text/javascript">

$(document).ready(function () {
	blog_sharrre('@DetailUrl(moduleData.DetailPageTabId(), articleData, categoryData)', '')
});

function blog_sharrre(pageUrl, iconClass) {
    var list = ['facebook', 'linkedin'];
    $('#rocket-sharrre').sharrre({
        share: {
            facebook: true,
            linkedin: true
        },
        buttons: {
            facebook: {},
            linkedin: {}
        },
        url: pageUrl,
        enableCounter: false,
        enableHover: false,
        template: function () {
            content = '';
            for (i in list) {
                service = list[i];
				content += '<a class="' + service + '" href="#"><span class="ri-' + service + '"></span></a>';
            }
            return content;
        }(), render: function (api, options) {
            for (i in list) {
                service = list[i];
                $(api.element).on('click', '.' + service, function () {
                    api.openPopup(this.className);
                });
            }
        }
    });

}

$("[data-fancybox]").fancybox({
  lang : 'fr',
  i18n : {
      'fr' : {
          CLOSE       : 'Fermer',
          NEXT        : 'Suivant',
          PREV        : 'Précédent',
          ERROR       : 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
          PLAY_START  : 'Démarrer le diaporama',
          PLAY_STOP   : 'Mettre en pause le diaporama',
          FULL_SCREEN : 'Plein écran',
          THUMBS      : 'Vignettes',
          DOWNLOAD    : 'Télécharger',
          SHARE       : 'Partager',
          ZOOM        : 'Zoomer'
      }
  }
});

</script>
