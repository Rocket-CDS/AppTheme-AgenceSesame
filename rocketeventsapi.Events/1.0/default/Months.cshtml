@inherits RocketEventsAPI.Components.RocketEventsAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using Simplisity;
@using RocketEventsAPI.Components;
@using System.Globalization;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->
@{
    var eventList = (Dictionary<DateTime, List<ArticleLimpet>>)Model.GetDataObject("eventlistbymonth");
}
<div class="events-archives">
	<div class="events-archives-item rocket-monthdates rocket-monthdates0">
		<a href="@ListUrl(moduleData.ListPageTabId())">@ResourceKey("Events.showall")</a>
	</div>
    @{
        var monthidx = 1;
    }
    @foreach (var a in eventList.Reverse())
    {
        if (a.Value.Count > 0)
        {
            <div class="events-archives-item rocket-monthdates rocket-monthdates@(monthidx) ">
                <a href="@ListUrl(moduleData.ListPageTabId(), new string[] {"month", a.Key.Month.ToString(),"year", a.Key.Year.ToString() })" monthidx="@(monthidx)" onclick="setSelected($(this).attr('monthidx'));">
                    @a.Key.ToString("MMMM yyyy")
                    <span class="count">@a.Value.Count<span class="material-icons-outlined">calendar_today</span></span>
                </a>
            </div>

        }
        monthidx += 1;
    }
</div>

<script>
    function setSelected(monthidx, month, year) {
        simplisity_setSessionField('monthidx', monthidx);
    }
</script>
