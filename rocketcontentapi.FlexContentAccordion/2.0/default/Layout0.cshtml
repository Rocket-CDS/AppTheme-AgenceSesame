@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

@{
    var contentId = "content" + articleRowData.RowKey + sessionParams.ModuleId;
    var defaultOpenParentClass = "";
    var defaultOpenClass = "";
    var defaultOpenStyle = "display:none;";
    if (articleRowData.GetBool("genxml/checkbox/defaultopen"))
    {
        defaultOpenParentClass = "flexcontent-active";
        defaultOpenClass = "fc-active" + sessionParams.ModuleId;
        defaultOpenStyle = "";
    }
}

<div class="flexcontent-div @(defaultOpenParentClass) @rowData.GetXmlProperty("genxml/textbox/cssclass")">
    <div class="fca-header" onclick="slideAccordionFC('@(contentId)','@(sessionParams.ModuleId)','@(moduleData.GetSetting("disableaccordianmode"))')" style="cursor:pointer;">[INJECT:appthemeview,ArticleRowHeaderView.cshtml]</div>
<div id="@(contentId)" class="fca-content @(defaultOpenClass)" style="@(defaultOpenStyle)">
    <div class="flexcontent-text">
        @HtmlOf(rowData.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))
        @HtmlOf(rowData.GetXmlProperty("genxml/lang/genxml/textbox/htmltext"))
        @if (articleRowData.GetLinkList().Count() > 0) {
        <div class="newspaper-link">
            [INJECT:appthemeview,Links.cshtml]
        </div>
        }
        @if (articleRowData.GetDocList().Count() > 0) {
        <div class="documents">
            [INJECT:appthemeview,Documents.cshtml]
        </div>
        }
    </div>
</div>
</div>
