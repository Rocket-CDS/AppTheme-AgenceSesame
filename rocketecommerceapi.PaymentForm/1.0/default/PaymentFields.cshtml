@inherits RocketEcommerceAPI.Components.RocketEcommerceAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketEcommerceAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@AddProcessData("resourcepath", "/DesktopModules/DNNrocket/api/App_LocalResources/")
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketECommerceAPI/App_LocalResources/")

@{
    var appTheme = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var sessionParams = (SessionParams)Model.SessionParamsData;
    var portalShop = (PortalShopLimpet)Model.GetDataObject("portalshop");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var notification = (NotificationLimpet)Model.GetDataObject("notificationdata");
    var systemData = (SystemLimpet)Model.GetDataObject("systemdata"); ;
    var companyData = (CompanyLimpet)Model.GetDataObject("companydata"); ;
    var paymentData = (CompanyLimpet)Model.GetDataObject("paymentdata");
    var info = new SimplisityInfo();
    if (paymentData != null)
    {
        info = paymentData.Info;
    }   
}

<div class="formdata">

    @if (notification.Message_PaymentForm != "")
    {
    <p>@BreakOf(notification.Message_PaymentForm)</p>
    }
    <div class="formdatafield formdataamount">
        <label>@ResourceKey("RE.amount")</label>
        @TextBoxMoney(info.PortalId, info.Lang, info, "genxml/textbox/amountpay", "  name='amount' onKeyUp='numericFilter(this,100000);' placeholder='' required  autocomplete='off' ", "0", false, 0, "", "")
    </div>
    <div class="formdatafield">
        @TextBox(info, "genxml/textbox/email", " name='email' required email autocomplete='off' placeholder='" + ResourceKey("RE.email") + "'")
    </div>
    <div class="formdatafield">
        @TextBox(info, "genxml/textbox/company", " name='company' autocomplete='off' placeholder='" + ResourceKey("RE.company") + "'")
    </div>
    <div class="formdatafield">
        @TextBox(info, "genxml/textbox/firstname", " name='firstname' autocomplete='off' placeholder='" + ResourceKey("RE.firstname") + "'")
    </div>
    <div class="formdatafield">
        @TextBox(info, "genxml/textbox/lastname", " name='lastname' autocomplete='off' placeholder='" + ResourceKey("RE.lastname") + "'")
    </div>
    <div class="formdatafield">
        @TextBox(info, "genxml/textbox/invoiceref", " name='ref' autocomplete='off' placeholder='" + ResourceKey("RE.ref") + "'")
    </div>
    @{
        var payList = portalShop.GetActivePaymentMethods();
        var buttoncolor = "w3-green";
        foreach (var p in payList)
        {
			<div class="dovalidatepayment simplisity_click " s-return="document" s-before="validatePayment" s-cmd="remote_publicpay" s-post="#datasection" s-fields='{"providerkey":"@(p.PaymentProvKey())","systemkey":"rocketecommerceapi"}'>
				<button class="bigbutton">@ResourceKey("RE.pay")</button>
			</div>
        }
    }
</div>

<script>
    $(document).ready(function () {

        // Take ALL params passed to the page and pass them to the server as hidden fields in paramInfo.
        var urlParams = new URLSearchParams(window.location.search);
        urlParams.forEach(function (value, key) {
            simplisity_setParamField(key, value);
        });

        $(document).simplisityStartUp('@(portalShop.ApiUrl)', { systemkey: 'rocketpayment', debug: false });        

        if (urlParams.get('amount') != null && typeof urlParams.get('amount') != 'undefined' && urlParams.get('amount') != '') {
            $('#amountpay').val(urlParams.get('amount'));
        }
        if (urlParams.get('ref') != null && typeof urlParams.get('ref') != 'undefined' && urlParams.get('ref') != '') {
            $('#invoiceref').val(urlParams.get('ref'));
        }
        
        $('.simplisity_loader').hide();

    });

    function validatePayment() {

        var form = $("#Form");

        jQuery.validator.addMethod("greaterThanZero", function(value, element) {
            return this.optional(element) || (parseFloat(value) > 0);
        }, "");

        form.validate({
            rules: {
                email: {
                    required: true,
                    email: true
                },
                amount : { greaterThanZero : true }
            },
            errorPlacement: function () {
                return false;  // suppresses error message text
            },
            invalidHandler: function (e, validator) {
                $('input').removeClass('w3-pale-red');
                $('input').removeClass('w3-border-red');
                for (var i in validator.errorMap) {
                    $('#' + i).addClass('w3-pale-red');
                    $('#' + i).addClass('w3-border-red')
                }
            },
            amount: {
                required: true,
                digits: true
            }
        });
        
        if (!form.valid()) {
            $('.dovalidatepayment').attr('s-stop', 'stop')
        }
        else {
            $('.formdata').hide();
            $('.formdataprocess').show();            
            $('.simplisity_loader').show();
        }

    }
    function numericFilter(txb, max) {
        var valid = /^\d{0,6}([\.\,]\d{0,2})?$/.test(txb.value),
            val = txb.value;
        if (!valid) {
            txb.value = val.substring(0, val.length - 1);
        }
        if (parseFloat(txb.value) > max) {
            txb.value = max;
        }
    }

</script>

