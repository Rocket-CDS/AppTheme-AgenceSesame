@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");

    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var moduleDataSrc = new ModuleContentLimpet(moduleData.PortalId, moduleData.DataRef, moduleData.SystemKey);
    var limit = moduleData.Record.GetXmlPropertyInt("genxml/settings/limit");

    // Path to the resx file
    AddProcessData("resourcepath", "/DesktopModules/RocketThemes/AppThemes-W3-CSS/rocketcontentapi.Contact/1.0/resx");

}

<h3>Dernières actus</h3>
    
@{var lp = 1; }
<!-- Faire le href plus tard parce que j'ai pas d'idée de comment le faire -->
<div class="latest-news">
    @foreach (var articleRowData in articleData.GetRows())
    {
       
        var info = articleRowData.Info;
        // Changement format de date (dd/MM/yyy)
        var date = info.GetXmlPropertyDate("genxml/lang/genxml/textbox/newsdate");
        var dateFormat = date.ToString("dd/MM/yyyy");
        string[] urlparams = { "eid", lp.ToString(), info.GetXmlProperty("genxml/lang/genxml/textbox/title") };
        <!-- TODO refaire bien le lien vers détail article j'ai supprimé le bon module T-T -->
        var detailurl = DNNrocketUtils.NavigateURL(moduleDataSrc.Record.GetXmlPropertyInt("genxml/settings/linktab"), urlparams);

        <a href="@(detailurl)"><span>@(date.ToString("dd")) / @(date.ToString("MMM")) | </span>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</a><br /><br />

        if (lp == limit)
        {
            break;
        }
        lp++;
    }
</div>

<!-- TODO refaire le lien vers la page d'article, j'ai supprimé le bon module T-T -->
@{var tabddlvalue = PagesUtils.NavigateURL(moduleDataSrc.Record.GetXmlPropertyInt("genxml/settings/listlinktab"));}
<a class="bigbutton" href="@(tabddlvalue)">Toutes les actualités</a>
