@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");

    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/setting/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass");
    }
}

<div class="parallax-window">
    @foreach (var articleRowData in articleData.GetRows())
    {
        var info = articleRowData.Info;
        // var imageurl = info.GetXmlProperty("genxml/imgs/genxml[1]/hidden/imageurl");
        if (!info.GetXmlPropertyBool("genxml/checkbox/hiderow"))
        {
            <div class="parallax-content">
                <h2><b>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</b></h2>
                <hr />
                <div class="parallax-text">@info.GetXmlProperty("genxml/lang/genxml/textbox/content")</div>
                <div class="parallax-link">
                    @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
                    {
                        var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
                        var anchor = "";
                        if (info.GetXmlProperty("genxml/textbox/linkanchor") != "")
                        {
                            anchor = "#" + info.GetXmlProperty("genxml/textbox/linkanchor");
                        }
                        <a href="@(tabddlvalue)@(anchor)">@info.GetXmlProperty("genxml/lang/genxml/textbox/linktitle")</a>
                    }
                    @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
                    {
                        var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
                        var blank = "";
                        if (info.GetXmlPropertyBool("genxml/checkbox/blank"))
                        {
                            blank = "_blank";
                        }
                        <a href="@(externalURL)" target="@(blank)">@info.GetXmlProperty("genxml/lang/genxml/textbox/linktitle")</a>
                    }

                </div>
            </div>
        }
    }
</div>


