@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->
@{
    var groupDict = catalogSettings.GetPropertyGroups();
    var info = moduleDataInfo;
    var categoryData = new CategoryLimpet(portalData.PortalId, moduleData.DefaultCategoryId, sessionParams.CultureCode, systemData.SystemKey);
    //NOTE: xPath for module settings must use "genxml/settings/*"
}

<!-- List Settings -->
@if (moduleData.DisplayTemplate == "view.cshtml")
{ 
<div class='w3-row'>

        <div class="w3-third w3-padding">
            <label>@ResourceKey("RC.defaultcategory")&nbsp;</label>
            <div class="w3-row">
                <div id="defaultcategorydisplay" class="w3-border w3-light-grey " style="width:100%;height:40px;">
                    @categoryData.Name
                    <span class="w3-right w3-button w3-theme parentcategoryselect" onclick="$('#categoryselect').show();" style="width:64px;height:40px;">@ButtonIcon(ButtonTypes.tree)</span>
                </div>
            </div>
            @HiddenField(info, "genxml/settings/defaultcategory")
            @RenderTemplate("ModuleSettingsCatSelect.cshtml", appThemeDirectory, Model, true)
        </div>
        <div class="w3-row">
            <div class="w3-quarter w3-padding">
                @CheckBox(info, "genxml/settings/showsearchtext", ResourceKey("RC.showsearchtext").ToString(), "class='w3-check'")
            </div>
            <div class="w3-quarter w3-padding">
                @CheckBox(info, "genxml/settings/showorderby", ResourceKey("RC.showorderby").ToString(), "class='w3-check'")
            </div>
            <div class="w3-quarter w3-padding">
                @CheckBox(info, "genxml/settings/showpagesize", ResourceKey("RC.showpagesize").ToString(), "class='w3-check'")
            </div>
        </div>

    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.width") (List)</label>
        @TextBox(info, "genxml/settings/widthlist", "type='number' class='w3-input w3-border'", "300")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.height") (List)</label>
        @TextBox(info, "genxml/settings/heightlist", "type='number' class='w3-input w3-border'", "240")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.width") (Detail)</label>
        @TextBox(info, "genxml/settings/widthdetail", "type='number' class='w3-input w3-border'", "800")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.height") (Detail)</label>
        @TextBox(info, "genxml/settings/heightdetail", "type='number' class='w3-input w3-border'", "600")
    </div>
</div>
<div class='w3-row'>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.pagesize")</label>
        @DropDownList(info, "genxml/settings/pagesize", "12,24,48", "12,24,48", " style='height:40px;' class='w3-input w3-border simplisity_sessionfield ' onchange=\"doSearchReload();return false;\" title='" + @ResourceKey("DNNrocket.pagesize", sessionParams.CultureCode) + "'", "24")
    </div>
</div>
}

<!-- Filter Settings -->
@if (moduleData.DisplayTemplate == "filters.cshtml")
{
<div class="w3-row w3-padding">
    <div class="w3-large w3-margin-bottom">@ResourceKey("RC.propertygroups")</div>
    @foreach (var p in groupDict)
    {
        <span class="w3-padding">
            @CheckBox(info, "genxml/settings/propertygroup-" + p.Key.ToLower(),p.Value," class='w3-check' ")
        </span>
    }
</div>
}

<!-- Satellite Settings -->
@if (moduleData.DisplayTemplate == "featured.cshtml")
{
    <div class="w3-row w3-padding">
        <label>@ResourceKey("RC.defaultcategory")&nbsp;</label>
        <div class="w3-row">
            <div id="defaultcategorydisplay" class="w3-border w3-light-grey " style="width:100%;height:40px;">
                @categoryData.Name
                <span class="w3-right w3-button w3-theme parentcategoryselect" onclick="$('#categoryselect').show();" style="width:64px;height:40px;">@ButtonIcon(ButtonTypes.tree)</span>
            </div>
        </div>
        @HiddenField(info, "genxml/settings/defaultcategory")
        @RenderTemplate("ModuleSettingsCatSelect.cshtml", appThemeDirectory, Model, true)
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.rowlimit")</label>
        @TextBox(info, "genxml/settings/itemlimit", "type='number' class='w3-input w3-border'", "0")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.width") (List)</label>
        @TextBox(info, "genxml/settings/widthlist", "type='number' class='w3-input w3-border'", "300")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.height") (List)</label>
        @TextBox(info, "genxml/settings/heightlist", "type='number' class='w3-input w3-border'", "240")
    </div>

}