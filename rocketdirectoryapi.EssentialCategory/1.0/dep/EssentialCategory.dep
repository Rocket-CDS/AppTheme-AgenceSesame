<genxml>
	<deps list="true">
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/css/w3.css]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/Simplisity/css/simplisity.css]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/Simplisity/js/simplisity.js]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[{appthemefolder}/css/EssentialCategory.css]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[{appthemefolder}/js/EssentialCategory.js]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/js/jquery.validate.min.js]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>		
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[https://fonts.googleapis.com/css?family=Roboto:regular,bold,italic,thin,light,bolditalic,black,medium]]></url>
			<ecofriendly>true</ecofriendly>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[https://fonts.googleapis.com/icon?family=Material+Icons]]></url>
			<ecofriendly>true</ecofriendly>
