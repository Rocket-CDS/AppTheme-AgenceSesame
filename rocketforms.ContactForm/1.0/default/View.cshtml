@inherits RocketForms.Components.RocketFormsTokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketContentAPI.Components;
@using Simplisity;
@using RazorEngine.Text;
@using Rocket.AppThemes.Components;
@using RocketPortal.Components;

@{ 
    var sessionParams = Model.SessionParamsData;
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var appTheme = (AppThemeLimpet)Model.GetDataObject("apptheme");
    var info = new SimplisityInfo();

    AddProcessDataResx(appTheme, true);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketForms/App_LocalResources/");

    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/setting/cssclass") != "")
    {
        cssClass = "class='" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass") + "' ";
    }

    if (DNNrocketUtils.GetCurrentLanguageCode() != "en")
    {
        <script type="text/javascript" src="/DesktopModules/DNNrocket/js/localization/messages_@(DNNrocketUtils.GetCurrentLanguageCode()).js"></script> 
    }
}

@if (!GeneralUtils.IsEmail(moduleData.GetSetting("fromemail")) || !GeneralUtils.IsEmail(moduleData.GetSetting("manageremail")))
{
    <div style="background-color:red;color:black;">
        @ResourceKey("RocketForms.fromemailerror")    
    </div>
}
<div @(cssClass)>
    <div id="contactform@(moduleData.ModuleId)" class="contactform">
        <div class="contactformfields">
            <div class="cff-100">
                <div class="cff-50">
                    <label>@ResourceKey("RocketForms.name")</label>
                    @TextBox(info, "genxml/textbox/name")
                </div>
                <div class="cff-50">
                    <label>@ResourceKey("RocketForms.company")</label>
                    @TextBox(info, "genxml/textbox/company")
                </div>
            </div>
            <div class="cff-100">
                <div class="cff-50">
                    <label>@ResourceKey("RocketForms.email") *</label>
                    @TextBox(info, "genxml/textbox/email", "type='email' required")
                </div>
                <div class="cff-50">
                    <label>@ResourceKey("RocketForms.tel")</label>
                    @TextBox(info, "genxml/textbox/tel")
                </div>
            </div>
            <div class="cff-50">
                <label>@ResourceKey("RocketForms.subject")</label>
                @TextBox(info, "genxml/textbox/subject")
            </div>
            <br />
            <div class="cff-50">
                <label>@ResourceKey("RocketForms.message")</label>
                @TextArea(info, "genxml/textbox/message")
            </div>
        </div>

        <div class="cff-cb">
            <input type="checkbox" name="gdprcheckbox" id="gdprcheckbox" required update="save" aria-required="true">
            <label for="gdprcheckbox">@ResourceKey("RocketForms.gdprmessage")</label>
        </div>

        <div class="cff-required"><i>@ResourceKey("RocketForms.compulsory")</i></div>

        <div id="buttondiv@(moduleData.ModuleId)" class="bigbutton simplisity_panel" style="min-height:40px;">
            <div class="bigbutton">@ResourceKey("RocketForms.send")</div>
        </div>
        <div id="myBarWrapper@(moduleData.ModuleId)" class="w3-light-grey w3-margin" style="display:none;">
            <div id="myBar@(moduleData.ModuleId)" class="w3-container w3-green" style="height:24px;width:1%"></div>
        </div>
        <!-- we must pass moduleid to server -->
        @HiddenField(info, "genxml/hidden/moduleid", "", moduleData.ModuleId.ToString())
    </div>
</div>

<script>
    $(document).ready(function () {

        setTimeout(function () {
            var buttontext = '<button id="sendemail@(moduleData.ModuleId)" type="button" class="bigbutton simplisity_click" s-before="validate@(moduleData.ModuleId)" s-return="#buttondiv@(moduleData.ModuleId)"  s-cmdurl="/Desktopmodules/dnnrocket/api/rocket/action" s-cmd="rocketforms_publicpostform"  s-post="#contactform@(moduleData.ModuleId)" >@ResourceKey("RocketForms.send")</button>'
            $('#buttondiv@(moduleData.ModuleId)').html(buttontext);
            $('#contactform@(moduleData.ModuleId)').activateSimplisityPanel();
        }, 1200);

    });

    function validate@(moduleData.ModuleId)() {
        var form = $("#Form");
        form.validate();

        if (form.valid()) {
            move@(moduleData.ModuleId)();
        } else {
            $('#sendemail@(moduleData.ModuleId)').attr('s-stop', 'stop');
        }
    }

    function move@(moduleData.ModuleId)() {


        $('#buttondiv@(moduleData.ModuleId)').html('');
        $('#myBarWrapper@(moduleData.ModuleId)').appendTo('#buttondiv@(moduleData.ModuleId)')
        $('#myBarWrapper@(moduleData.ModuleId)').show();

        var elem = document.getElementById("myBar@(moduleData.ModuleId)");
        var width = 1;
        var id = setInterval(frame, 30);
        function frame() {
            if (width >= 100) {
                clearInterval(id);
            } else {
                width++;
                elem.style.width = width + '%';
            }
        }
    }
</script>



