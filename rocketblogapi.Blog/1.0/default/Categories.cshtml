@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")
<!--inject-->

<div class="blog-categories">
    <div class="h3-headline">@ResourceKey("DNNrocket.categories")</div>
    <ul>
        <li><a href="@DNNrocketUtils.NavigateURL(sessionParams.TabId)" onclick="clearDateSearch();$('.simplisity_loader').show();">@ResourceKey("Blog.allcategories")</a></li>
        @foreach (var c in categoryDataList.GetCategoryTree())
        {
            if (!c.Hidden && !c.HiddenByCulture && c.Level == 0)
            {
                if (c.Level == 0)
                {
                    var l = c.GetDirectChildren();
                    var catDict = new Dictionary<string, string>();
                    catDict.Add("catid", c.CategoryId.ToString());
                    if (l.Count == 0)
                    {
                        <li><a href="@DNNrocketUtils.NavigateURL(sessionParams.TabId, catDict, c.Name)" onclick="clearDateSearch();$('.simplisity_loader').show();">@c.Name (@c.GetArticles().RecordCount)</a></li>
                    }
                }
            }
        }
    </ul>
</div>