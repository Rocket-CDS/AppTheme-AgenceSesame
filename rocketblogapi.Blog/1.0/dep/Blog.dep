<genxml>
	<deps list="true">
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url>{jquery}</url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/Simplisity/css/simplisity.css]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[/DesktopModules/DNNrocket/Simplisity/js/simplisity.js]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[{appthemefolder}/js/blog.js]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[{appthemefolder}/css/Blog.css]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url>https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.css</url>
			<ecofriendly>false</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
	  	<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url>https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.js</url>
		  	<ecofriendly>false</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
	  	</genxml>
		<genxml>
			<ctrltype><![CDATA[js]]></ctrltype>
			<url><![CDATA[{appthemefolder}/js/jquery.sharrre.min.js]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
		<genxml>
			<ctrltype><![CDATA[css]]></ctrltype>
			<url><![CDATA[/DesktopModules/RocketThemes/AppTheme-AgenceSesame/rocket-icons-v1.0/style.css]]></url>
			<ecofriendly>true</ecofriendly>
			<ignoreontemplate>ArticleSat.cshtml</ignoreontemplate>
		</genxml>
	</deps>
	<moduletemplates list="true">
		<genxml>
			<file><![CDATA[view.cshtml]]></file>
			<name><![CDATA[List View]]></name>
			<cmd>listdetail</cmd>
		</genxml>
		<genxml>
			<file><![CDATA[Categories.cshtml]]></file>
			<name><![CDATA[Category Menu]]></name>
			<cmd>catmenu</cmd>
		</genxml>
		<genxml>
			<file><![CDATA[Filters.cshtml]]></file>
			<name><![CDATA[Filters]]></name>
			<cmd>catmenu</cmd>
		</genxml>
		<genxml>
			<file><![CDATA[Tags.cshtml]]></file>
			<name><![CDATA[Tags]]></name>
			<cmd>catmenu</cmd>
		</genxml>
		<genxml>
			<file><![CDATA[Months.cshtml]]></file>
			<name><![CDATA[Months]]></name>
			<cmd>catmenu</cmd>
		</genxml>
		<genxml>
			<file><![CDATA[ArticleSat.cshtml]]></file>
			<name><![CDATA[Satellite]]></name>
			<cmd>satellite</cmd>
		</genxml>
	</moduletemplates>
	<adminpanelinterfacekeys list="true">
		<genxml>
			<interfacekey>articleadmin</interfacekey>
			<show>true</show>
		</genxml>
		<genxml>
			<interfacekey>categoryadmin</interfacekey>
			<show>true</show>
		</genxml>
		<genxml>
			<interfacekey>propertyadmin</interfacekey>
			<show>true</show>
		</genxml>
		<genxml>
			<interfacekey>settingsadmin</interfacekey>
			<show>true</show>
		</genxml>
		<genxml>
			<interfacekey>rocketdirectoryadmin</interfacekey>
			<show>true</show>
		</genxml>
	</adminpanelinterfacekeys>
	<queryparams list="true">
		<genxml>
			<queryparam>blogcatid</queryparam>
			<tablename>rocketdirectoryapi</tablename>
			<systemkey>rocketblogapi</systemkey>
			<datatype>category</datatype>
		</genxml>
		<genxml>
			<queryparam>post</queryparam>
			<tablename>rocketdirectoryapi</tablename>
			<systemkey>rocketblogapi</systemkey>
			<datatype>article</datatype>
		</genxml>
	</queryparams>	
</genxml>
