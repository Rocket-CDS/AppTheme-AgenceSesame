@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var articleRowData = (ArticleRowLimpet)Model.GetDataObject("articlerow");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var appThemeSystem = (AppThemeSystemLimpet)Model.GetDataObject("appthemesystem");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();
    var sessionParams = Model.SessionParamsData;
    if (sessionParams == null)
    {
        sessionParams = new SessionParams(new SimplisityInfo());
    }
    var info = new SimplisityInfo();
    if (articleRowData != null && articleRowData.Info != null)
    {
        info = articleRowData.Info;
    }

    AddProcessDataResx(appThemeView, true);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

}


<!-- require Key for saving -->
@HiddenField(info, "genxml/config/rowkey")
@HiddenField(info, "genxml/lang/genxml/config/rowkeylang", "", articleRowData.RowKey)

<div class='w3-row w3-xlarge w3-padding'>
    @info.GetXmlProperty("genxml/lang/genxml/textbox/title")
</div>

<div class='w3-row w3-padding'>

    <div class="w3-bar" style="cursor: pointer;">
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink headingtablink" onclick="openSection('heading')">Layout</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink htmltablink" onclick="openSection('html')">HTML</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink imgstablink" onclick="openSection('imgs')">Images</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink docstablink" onclick="openSection('docs')">Document</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink linkstablink" onclick="openSection('links')">Links</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink htmltexttablink" onclick="openSection('htmltext')">HTML Text</div>
        <div class="w3-bar-item w3-bottombar w3-hover-grey w3-padding tablink othertablink" onclick="openSection('video')">Video</div>
    </div>

    <div id="heading" class='w3-row sectionname' style="display:none">

        <div class='w3-row w3-margin-top w3-border'>
            <div class="w3-half">
                <div class='w3-col m12 w3-padding' style='min-width: 200px;'>
                    <label>Heading</label>		&nbsp;@EditFlag(sessionParams)
                    @TextBox(info, "genxml/lang/genxml/textbox/title", " id='title' class='w3-input w3-border' autocomplete='off' ", "", true, 0)
                </div>
            </div>
            <div class="w3-half">
                <div class='w3-col m2 w3-padding' style='min-width: 85px;'>
                    <label>Style</label>
                    @DropDownList(info, "genxml/select/headingstyle", "h1,h2,h3,h4", "H1,H2,H3,H4", "class='w3-select w3-border ' ", "", false, 0)
                </div>
                <div class='w3-col m4 w3-padding' style='min-width: 170px;'>
                    <label>Align</label>
                    @RadioButtonList(info, "genxml/select/headingalign", "start,center,end", "<span class='material-icons'>format_align_left</span>,<span class='material-icons'>format_align_center</span>,<span class='material-icons'>format_align_right</span>", "", "1", "", false, 0, "")
                </div>
                <div class='w3-col m2 w3-padding'>
                    <label>Hide</label><br />
                    @CheckBox(info, "genxml/checkbox/hideheading", "", "class='w3-check' ", false, false, 0)
                </div>
            </div>
            <div class="w3-third w3-padding">
                <label>Columns</label>
                @TextBox(info, "genxml/lang/genxml/textbox/columns", "type='number' class='w3-input w3-border'", "1")
            </div>
            <div class='w3-quarter w3-padding '>
                <label>Principal image</label>
                <p style="color:red;">En cours de developpement</p>
                <!-- TODO intégrer image principale -->
            </div>
        </div>

        <div class='w3-row w3-padding'>
            @{
                var imgLayoutList = "";
                for (int i = 0; i < 5; i++)
                {
                    imgLayoutList += "<img src='" + appThemeAdmin.AppThemeFolderRel + "/img/Newspaper" + i + ".png' />,";
                }
                imgLayoutList = imgLayoutList.TrimEnd(',');
            }
            <label>Layout</label>
            @RadioButtonList(info, "genxml/select/layout", "0,1,2,3,4", imgLayoutList, "class='  ' ", "0", "", false, 0)
        </div>

        <div class='w3-row'>
            <div class='w3-quarter w3-padding'>
                <label>Hide</label><br />
                @CheckBox(info, "genxml/checkbox/hiderow", "", "class='w3-check' ", false, false, 0)
            </div>
            <div class='w3-col m12 w3-padding' style='min-width: 200px;'>
                <label>Anchor id</label>		&nbsp;@EditFlag(sessionParams)
                @TextBox(info, "genxml/lang/genxml/textbox/anchor", "class='w3-input w3-border' autocomplete='off'", "", true, 0)
            </div>
            <div class='w3-col m12 w3-padding' style='min-width: 200px;'>
                <label>CSS Class</label>		&nbsp;@EditFlag(sessionParams)
                @TextBox(info, "genxml/lang/genxml/textbox/cssclass", "class='w3-input w3-border' autocomplete='off'", "", true, 0)
            </div>
        </div>

    </div>

    <div id="html" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding'>
            @EditFlag(sessionParams)
            <div class='w3-col m12'>
                @CKEditor4(info, "genxml/lang/genxml/textbox/richtext", true)
            </div>
            <div class='w3-col' style='width:0px;height:600px;'></div>
        </div>
    </div>
    <div id="imgs" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding '>
            @RenderTemplate("ArticleImagesListDetail.cshtml", appThemeSystem, Model, true)
        </div>
    </div>

    <div id="docs" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding '>
            @RenderTemplate("ArticleDocuments.cshtml", appThemeSystem, Model, true)
        </div>
    </div>

    <div id="links" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding '>
            @RenderTemplate("ArticleLink.cshtml", appThemeSystem, Model, true)
        </div>
    </div>

    <div id="htmltext" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding'>
            @EditFlag(sessionParams)
            @TextArea(info, "genxml/lang/genxml/textbox/htmltext", " class='w3-input w3-border' rows='8' ", "", true, 0)
        </div>
    </div>

    <div id="video" class='w3-row sectionname' style="display:none">
        <div class='w3-col m12 w3-padding'>
            <label>Embeded Video</label>
            @TextArea(info, "genxml/lang/genxml/textbox/video", " class='w3-input w3-border' rows='8' ", "", true, 0)
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var sectionName = localStorage.getItem('sectiontabs');
        if ((typeof sectionName === 'undefined') || sectionName === '' || sectionName === null) {
            sectionName = "heading";
        }
        openSection(sectionName);
        $('#summary').trigger('onkeyup');
        $('#text').trigger('onkeyup');
    });

    function openSection(sectionName) {
        $('.sectionname').hide();
        $('.tablink').removeClass("w3-border-black");
        $('.tablink').removeClass("w3-theme-l3");
        $('#' + sectionName).show();
        $('.' + sectionName + 'tablink').addClass("w3-border-black");
        $('.' + sectionName + 'tablink').addClass("w3-theme-l3");
        localStorage.setItem('sectiontabs', sectionName);

        // so the hidden one gets adjusted
        $('#summary').trigger('onkeyup');
        $('#text').trigger('onkeyup');
    }
</script>


