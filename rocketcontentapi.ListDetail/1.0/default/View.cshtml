@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

<!-- TODO Rendre ça plus propre - système D pour que ça marche -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.js"></script>

@{ 
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();
    var idx = Model.SessionParamsData.GetInt("idx");

    AddProcessDataResx(appThemeView, true);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/"); }

@if (idx > 0 && articleData.GetRowList().Count >= idx)
{
    var rtnUrl = DNNrocketUtils.NavigateURL(Model.SessionParamsData.TabId);
    var articleRowData = articleData.GetRow(idx - 1);
    var info = articleRowData.Info;

    var layout = info.GetXmlPropertyInt("genxml/select/layout");
    var hStyle = info.GetXmlProperty("genxml/select/headingstyle");
    var headingHide = info.GetXmlPropertyBool("genxml/checkbox/hideheading");
    var hideRow = info.GetXmlPropertyBool("genxml/checkbox/hiderow");
    var columnClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/settings/columns") != "def")
    {
        columnClass = info.GetXmlProperty("genxml/lang/genxml/textbox/columns");
    }
<div>
    <!-- TODO enlever le W3.CSS-->
    <a class="w3-right" href="@rtnUrl">Retour</a>
    <div class="flexcontent-wrapper fcw-@(columnClass)col">
        @if (!hideRow)
        {
            <div class="flexcontent-div @info.GetXmlProperty("genxml/lang/genxml/textbox/cssclass")">
                @if (!headingHide)
                {
                    var headingalignvalue = info.GetXmlPropertyInt("genxml/select/headingalign");

                    if (info.GetXmlProperty("genxml/lang/genxml/textbox/title") != "")
                    {
                        var alignText = info.GetXmlProperty("genxml/select/headingalign");
                        if (hStyle.ToLower() == "h1")
                        {
                            <div class="flexcontent-text">
                                <h1 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h1>
                            </div> 
                        }
                        if (hStyle.ToLower() == "h2")
                        {
                            <div class="flexcontent-text">
                                <h2 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>
                            </div> 
                        }
                        if (hStyle.ToLower() == "h3")
                        {
                            <div class="flexcontent-text">
                                <h3 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h3>
                            </div> 
                        }
                        if (hStyle.ToLower() == "h4")
                        {
                            <div class="flexcontent-text">
                                <h4 id="@info.GetXmlProperty("genxml/lang/genxml/textbox/anchor")" style="text-align: @alignText;">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h4>
                            </div>                            
                        }
                    }
                }
                @if (layout == 0)
                {
                    @RenderTemplate("layout0.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (layout == 1)
                {
                    @RenderTemplate("layout1.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (layout == 2)
                {
                    @RenderTemplate("layout2.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (layout == 3)
                {
                    @RenderTemplate("layout3.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (layout == 4)
                {
                    @RenderTemplate("layout4.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (info.GetXmlProperty("genxml/lang/genxml/textbox/htmltext") != "")
                {
                    @RenderTemplate("htmltext.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                @if (articleRowData.GetDocList().Count > 0)
                {
                    @RenderTemplate("documents.cshtml", moduleData.ModuleRef, appThemeView, Model, true)                    
                }
                <div class="newspaper-link">
                    @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
                    {
                        var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
                        <a href="@(tabddlvalue)#@info.GetXmlProperty("genxml/textbox/linkanchor")">@info.GetXmlProperty("genxml/textbox/linktitle")</a>
                    }
                    @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
                    {
                        var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
                        var blank = "";
                        if (@info.GetXmlPropertyBool("genxml/checkbox/blank"))
                        {
                              blank = "_blank";
                        }
                        <a href="@(externalURL)" target="@(blank)">@info.GetXmlProperty("genxml/textbox/linktitle")</a>
                    }
                </div>
            </div>                
        }
    </div>
</div> 
}
else
{
    var lp = 1;
    foreach (var articleRowData in articleData.GetRows())
    {
        var info = articleRowData.Info;
        var title = info.GetXmlProperty("genxml/lang/genxml/textbox/title");
        string[] urlparams = { "idx", lp.ToString() };
        var detailurl = DNNrocketUtils.NavigateURL(Model.SessionParamsData.TabId, urlparams);
        var datalist = articleRowData.GetImageList();
        <div class="w3-padding">
            <!-- Verification -->
            @foreach (var imgInfo in datalist)
            {
                var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + (lp-1) + "]/hidden/imagealtarticleimage");
                var articleImage = new ArticleImage(imgInfo, "articleimage");
                if (imgInfo.GetXmlPropertyBool("genxml/lang/genxml/checkbox/mainimages"))
                {
                    <img src="@ThumbnailImageUrl(articleImage.RelPath)" />
                }
            }
            <a href="@(detailurl)" class="w3-xlarge">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</a>
        </div>
        lp += 1;
    }

}

<script>
    $(document).ready(function () {
        simplisity_setSessionField('listurl@(moduleData.ModuleId)', window.location.href); // href to cookie so we can use it on the detail back button.
    });
    $("[data-fancybox]").fancybox({
        lang: 'fr',
        i18n: {
            'fr': {
                CLOSE: 'Fermer',
                NEXT: 'Suivant',
                PREV: 'Précédent',
                ERROR: 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
                PLAY_START: 'Démarrer le diaporama',
                PLAY_STOP: 'Mettre en pause le diaporama',
                FULL_SCREEN: 'Plein écran',
                THUMBS: 'Vignettes',
                DOWNLOAD: 'Télécharger',
                SHARE: 'Partager',
                ZOOM: 'Zoomer'
            }
        }
    });
</script>


