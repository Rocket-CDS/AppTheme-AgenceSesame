@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var info = new SimplisityInfo(moduleData.Record);

    AddProcessDataResx(appThemeAdmin);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

    //NOTE: xPath for module settings must use "genxml/settings/*"
}
<div class="w3-row">
    @CheckBox(info, "genxml/settings/companyname", "Company Name", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/adress", "Adress", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/tel1", "Tel. 1", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/tel2", "Tel. 2", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/fax", "Fax", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email", "Email", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contact1", "Contact 1", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contactname1", "Contact Name 1", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/mobile1", "mobile1", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email1", "Email 1", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contact2", "Contact 2", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contactname2", "Contact Name 2", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/mobile2", "Mobile 2", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email2", "Email 2", "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/extrainfo", "Extra Info", "class='w3-check contactCb' ")
</div>

<div class="w3-row">
    <div class="w3-third w3-padding">
        <label>CSS Class</label>
        @TextBox(info, "genxml/settings/cssclass", "class='w3-input w3-border'", "")
    </div>
</div>

<script>

</script>
