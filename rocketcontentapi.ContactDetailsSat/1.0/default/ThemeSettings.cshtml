@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var info = new SimplisityInfo(moduleData.Record);

    AddProcessDataResx(appThemeAdmin, true);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

    //NOTE: xPath for module settings must use "genxml/settings/*"
}
<div class="w3-row">
    @CheckBox(info, "genxml/settings/companyname", ResourceKey("DNNrocket.companyName").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/adress", ResourceKey("DNNrocket.adress").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/tel1", ResourceKey("DNNrocket.tel1").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/tel2", ResourceKey("DNNrocket.tel2").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/fax", ResourceKey("DNNrocket.fax").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email", ResourceKey("DNNrocket.email").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contact1", ResourceKey("DNNrocket.contact1").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contactname1", ResourceKey("DNNrocket.contactname1").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/mobile1", ResourceKey("DNNrocket.mobile1").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email1", ResourceKey("DNNrocket.email1").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contact2", ResourceKey("DNNrocket.contact2").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/contactname2", ResourceKey("DNNrocket.contactname2").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/mobile2", ResourceKey("DNNrocket.mobile2").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/email2", ResourceKey("DNNrocket.email2").ToString(), "class='w3-check contactCb' ")</br>
    @CheckBox(info, "genxml/settings/extrainfo", ResourceKey("DNNrocket.extraInfo").ToString(), "class='w3-check contactCb' ")
</div>

<div class="w3-row">
    <div class="w3-third w3-padding">
        <label>@ResourceKey("DNNrocket.cssClass")</label>
        @TextBox(info, "genxml/settings/cssclass", "class='w3-input w3-border'", "")
    </div>
</div>

<script>

</script>
