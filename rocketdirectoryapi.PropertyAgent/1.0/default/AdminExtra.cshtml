@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->

<div class=" w3-row w3-padding">
    <label>Notes</label>&nbsp;@EditFlag(sessionParams)
    @TextBox(info, "genxml/lang/genxml/textbox/articlenotes", " class='w3-input w3-border' autocomplete='off' ", "", true, 0)
</div>
<div class=" w3-row w3-padding">
    <label>Localisation</label>&nbsp;@EditFlag(sessionParams)
    @TextBox(info, "genxml/lang/genxml/textbox/articlearea", " class='w3-input w3-border' autocomplete='off' ", "", true, 0)
</div>
<div class='w3-row'>
    <div class="w3-col m6 w3-padding">
        <label>Note DPE</label>
        @DropDownList(info, "genxml/select/dpe", ",A,B,C,D,E,F,G", ",A,B,C,D,E,F,G", "class='w3-input w3-border' ", "", false)
    </div>
    <div class="w3-col m6 w3-padding">
        <label>Note GES</label>
        @DropDownList(info, "genxml/select/ges", ",A,B,C,D,E,F,G", ",A,B,C,D,E,F,G", "class='w3-input w3-border' ", "", false)
    </div>
</div>
<div class=" w3-row w3-padding">
    <label>Vidéo</label>
    @TextArea(info, "genxml/textbox/videoembed", " class='w3-input w3-border' rows='3' autocomplete='off' ", "", false, 0)
</div>