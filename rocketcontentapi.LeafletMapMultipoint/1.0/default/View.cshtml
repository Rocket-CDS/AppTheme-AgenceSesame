@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketContentAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

@{

    var width = moduleData.GetSettingInt("width");
    var height = moduleData.GetSettingInt("height");
    var zoom = moduleData.GetSettingInt("zoom");
    var mapLong = moduleData.GetSettingInt("long");
    var mapLat = moduleData.GetSettingInt("lat");
}

<div class="@(moduleData.GetSettingInt("cssclass"))">
    [INJECT:appthemesystem,ArticleHeaderView.cshtml]
    <div id="map-canvas" style="width:@(width)%;height:@(height)px"></div>
</div>

<script type="text/javascript">
    var map = '';

  $(document).ready(function () {
    initmap();
  });

  function initmap() {
    map = L.map('map-canvas', {
      scrollWheelZoom: false
    });

      var markers = [
    @foreach (var articleRowData in articleData.GetRows())
    {        
        var info = articleRowData.Info;
        if (!articleRowData.IsHidden && articleRowData.Get("genxml/textbox/lat") != "" && articleRowData.Get("genxml/textbox/long") != "")
        {
            @:L.marker([@articleRowData.Get("genxml/textbox/lat"), @articleRowData.Get("genxml/textbox/long")]).bindPopup('@articleRowData.Get("genxml/lang/genxml/textbox/title")'),            
        }
    }
    ];
        var group = L.featureGroup(markers).addTo(map);
      map.fitBounds(group.getBounds(), {
        padding: [80, 80]
    });
        map.on('focus', function() { map.scrollWheelZoom.enable(); });
        map.on('blur', function() { map.scrollWheelZoom.disable(); });

        L.tileLayer('https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://osm.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);
    }
</script>

