@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();

    AddProcessDataResx(appThemeView);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

    var headingArticleRowData = (ArticleRowLimpet)Model.GetDataObject("articlerow");
    var hInfo = headingArticleRowData.Info;

    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/setting/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass");
    }

}
<div @(cssClass)>
    <!-- HEADER SECTION -->
    @{
        var headerStyle = articleData.Info.GetXmlProperty("genxml/header/headerstyle");
        var moduleTitle = articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headertitle");
    }

    @if (headerStyle == "")
    {
        headerStyle = "h1";
    }
    @if (moduleTitle != "")
    {
        var headerAlignText = articleData.Info.GetXmlProperty("genxml/header/headeralign");
        if (headerStyle.ToLower() == "h1")
        {
            <h1 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h1>
        }
        if (headerStyle.ToLower() == "h2")
        {
            <h2 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h2>
        }
        if (headerStyle.ToLower() == "h3")
        {
            <h3 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h3>
        }
        if (headerStyle.ToLower() == "h4")
        {
            <h4 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h4>
        }
    }

    <div id="accordion">
        @foreach (var articleRowData in articleData.GetRows())
        {
            var info = articleRowData.Info;
            var rowCssClass = "";
            if (info.GetXmlProperty("genxml/textbox/cssclass") != "")
            {
                rowCssClass = "class=" + info.GetXmlProperty("genxml/textbox/cssclass");
            }
            <div @(rowCssClass)>
                <div class="accordion-header" style="cursor:pointer;">
                    <p>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</p>
                    <p>@info.GetXmlProperty("genxml/lang/genxml/textbox/categorie")</p>
                </div>
                <div class="accordion-content" style="display: none;">@HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))</div>
                <hr />
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    jQuery(document).ready(function () {
        $('#accordion').accordion({
            header: ".accordion-header",
            heightStyle: "content",
            collapsible: true,
            active: false
        });
    });
</script>




