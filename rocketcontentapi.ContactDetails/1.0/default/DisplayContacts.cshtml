@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@AssignDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

@foreach (var contactInfo in articleRowData.GetLinkList())
{
    if (contactInfo.GetXmlProperty("genxml/lang/genxml/textbox/contactmulti") != "")
    {
    <div class="contact-item">
        <div class="ci-header">
            <span class="ri-user"></span>
        </div>
        <div class="ci-content">
            <h3>@contactInfo.GetXmlProperty("genxml/lang/genxml/textbox/contactmulti")</h3>
            @if (contactInfo.GetXmlProperty("genxml/textbox/namemulti") != "")
            {
                <div>@contactInfo.GetXmlProperty("genxml/textbox/namemulti")</div>
            }
            @if (contactInfo.GetXmlProperty("genxml/textbox/mobilemulti") != "")
            {
                if (contactInfo.GetXmlProperty("genxml/textbox/clickmobilemulti") != "")
				{
				<div>@ResourceKey("DNNrocket.mobile") : <a href="tel:@contactInfo.GetXmlProperty("genxml/textbox/clickmobilemulti")">@contactInfo.GetXmlProperty("genxml/textbox/mobilemulti")</a></div>
				}
				else
				{
				<div>@ResourceKey("DNNrocket.mobile") : @contactInfo.GetXmlProperty("genxml/textbox/mobilemulti")</div>
				}
            }
            @if (contactInfo.GetXmlProperty("genxml/textbox/emailmulti") != "")
            {
                <div>@EmailOf(contactInfo, "genxml/textbox/emailmulti")</div>
            }
        </div>
    </div>
    }
}