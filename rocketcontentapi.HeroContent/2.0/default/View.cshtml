@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@AssigDataModel(Model)
@AddProcessDataResx(appThemeAdmin, true)
<!--inject-->
@{
    var info = moduleDataInfo;
    var mask = "";
    if (moduleData.GetSettingBool("mask"))
    {
        mask = "tih-mask";
    }
    var articleImage = articleRowData.GetImage(0);
    var linkData = articleRowData.Getlink(0);
    var width = moduleData.GetSettingInt("width");
    var height = moduleData.GetSettingInt("height");
    var crop = rowData.GetXmlProperty("genxml/select/crop");
    if (crop == "")
    {
        crop = "center";
    }
    var openDiv = "";
    var closeDiv = "";
    if (moduleData.GetSetting("cssclass") != "")
    {
        openDiv = "<div class='" + moduleData.GetSetting("cssclass") + "'>";
        closeDiv = "</div>";
    }
}

@HtmlOf(openDiv)
    <div class="herocontent @(mask)" style="background:url('@ImageUrl(articleImage.RelPath, width, height)') center @(crop) no-repeat;
                                            -webkit-background-size: cover;
                                            -moz-background-size: cover;
                                            -o-background-size: cover;
                                            background-size: cover;">
        <div class="caption">
            @if (rowData.GetXmlProperty("genxml/lang/genxml/textbox/title") != "")
            {
                <h2>@rowData.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>
            }
            @HtmlOf(rowData.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))
            @if (!linkData.Hidden && !linkData.IsDisabled)
            {
                <div class="herocontent-link"><a class="bigbutton" href="@(linkData.Url)" target="@(linkData.Target)">@linkData.Name</a></div>
            }
        </div>
    </div>
@HtmlOf(closeDiv)