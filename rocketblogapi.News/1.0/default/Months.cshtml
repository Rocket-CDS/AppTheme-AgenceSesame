@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using Simplisity;
@AssignDataModel(Model)
@AddProcessDataResx(appTheme, true)
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")
<!--inject-->

<div class="blog-archives">
    <div class="blog-archives-item">
        <a href="@ListUrl(moduleData.ListPageTabId())" onclick="$('.simplisity_loader').show();setSelected('');doDateSearchReload('','');">@ResourceKey("Blog.allnews")</a>
    </div>
    @{
        var monthidx = 1;
    }
    @foreach (var a in RocketDirectoryAPIUtils.GetArticlesByMonth(systemData.SystemKey, DateTime.Now.AddMonths(-36), 36, "publisheddate", sessionParams.GetInt("catid")))
    {
        if (a.Value.Count > 0)
        {
            <div class="blog-archives-item rocket-monthdates rocket-monthdates@(monthidx)" monthidx="@(monthidx)" onclick="$('.simplisity_loader').show();setSelected($(this).attr('monthidx'));doDateSearchReload('@a.Key.ToString("yyyy-MM-dd")','@a.Key.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")');$('html,body').animate({scrollTop:0},500);">
                @a.Key.ToString("MMMM yyyy")
                <span class="count">@a.Value.Count<span class="material-symbols-outlined">article</span></span>
            </div>
        }
        monthidx += 1;
    }
</div>

@DateJsApiCall(moduleData.SystemKey, "#rocket-blog", sessionParams)

<script>
    $(document).ready(function () {
        if (simplisity_getSessionField('searchdate1') != '')
        {
            setSelected(simplisity_getSessionField('monthidx'));
        }
        $('.rocket-tagbutton').click(function(){
            $('.rocket-monthdates').removeClass('selmonth');
        });
    });
    function setSelected(monthidx) {
        $('.rocket-monthdates').removeClass('selmonth');
        $('.rocket-monthdates' + monthidx).addClass('selmonth');
        simplisity_setSessionField('monthidx', monthidx);
    }
</script>
