@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var info = new SimplisityInfo(moduleData.Record);

    AddProcessDataResx(appThemeAdmin);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

    //NOTE: xPath for module settings must use "genxml/settings/*"
}
<div class="w3-row">
    <div class="w3-third w3-padding">
        <label>Image resize loading (px)</label>
        @TextBox(info, "genxml/settings/imageresize", " class='w3-input w3-border'", "640")
    </div>
    <div class="w3-row">
        <label><b>Detail Page</b></label>
    </div>
    <div class="w3-row">
        @TabSelectList(info, "genxml/settings/linktab", "class='w3-input w3-border'", false)
    </div>
    <div class="w3-row">
        <label><b>List Page</b></label>
    </div>
    <div class="w3-row">
        @TabSelectList(info, "genxml/settings/listlinktab", "class='w3-input w3-border'", false)
    </div>
    <div class="w3-row">
        <div class="w3-third w3-padding">
            <label>Width (px)</label>
            @TextBox(info, "genxml/settings/width", " class='w3-input w3-border'", "400")
        </div>    
        <div class="w3-third w3-padding">
            <label>Height (px)</label>
            @TextBox(info, "genxml/settings/height", " class='w3-input w3-border'", "300")
        </div>
    </div>
    <div class="w3-row">
        <label>CSS Class</label>
        @TextBox(info, "genxml/settings/cssclass", " class='w3-input w3-border'", "300")
    </div>
</div>

<script>
    $(document).ready(function () {
    });
</script>
