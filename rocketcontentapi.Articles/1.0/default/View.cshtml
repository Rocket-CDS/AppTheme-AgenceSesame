@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketContentAPI.Components;
@AssigDataModel(Model)
@AddProcessDataResx(appThemeView, true)
@AddProcessData("resourcepath", "/DesktopModules/RocketThemes/AppTheme-AgenceSesame/rocketcontentapi.Articles/1.0/resx")
<!--inject-->
@{
    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/settings/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass") + "";
    }
    var rowDetail = articleData.GetRow(sessionParams.Get("rowkey"));
}

@if (rowDetail != null)
{
    var rtnUrl = ListUrl(moduleData.GetSettingInt("listtabid"));
    var group = rowDetail.RowKey;
    var mainImage = rowDetail.GetImage(0);

    <div @(cssClass)>
    <article class="blog-detail">

        <a class="article-back bigbutton" href="@rtnUrl">@ResourceKey("DNNrocket.back")</a>
        <h1>@rowDetail.Get("genxml/lang/genxml/textbox/title")</h1>
        <div class="article-img">
                <img src="@ImageUrl(mainImage.RelPathWebp, moduleData.GetSettingInt("detailwidth"), moduleData.GetSettingInt("detailheight"))" alt="@(mainImage.Alt)" />
        </div>

        <p class="article-infos"><span>@ResourceKey("Articles.published") </span>@DateOf(info,"genxml/textbox/newsdate",sessionParams.CultureCode,"dd MMM yyyy")</p>

        <div class="article-content">

        @HtmlOf(rowDetail.Get("genxml/lang/genxml/textbox/richtext"))

        @foreach (var linkData in articleRowData.Getlinks())
        {    
            if (!linkData.Hidden)
            {
                <a href="@(linkData.Url)" target="@(linkData.Target)">@linkData.Name</a>
            }
        }

        @foreach (ArticleDoc documentData in rowDetail.GetDocs())
        {
            if (!documentData.Hidden)
            {
                <div>
                    <a href="@(documentData.RelPath)" target="_blank" >@documentData.Name</a>
                </div>
            }
        }


            @if (rowDetail.Get("genxml/lang/genxml/textbox/htmltext") != "")
            {
                <div><div class="video-container">@HtmlOf(rowDetail.Get("genxml/lang/genxml/textbox/htmltext"))</div></div>
            }

            @if (rowDetail.Get("genxml/lang/genxml/textbox/video") != "")
            {
                <div><div class="video-container">@HtmlOf(rowDetail.Get("genxml/lang/genxml/textbox/video"))</div></div>
            }
        </div>
        <div class="article-gallery">
            @foreach (var articleImage in rowDetail.GetImages())
            {
                <a data-fancybox="@(group)" data-caption="@(articleImage.Alt)" href="@ImageUrl(articleImage.RelPathWebp,0,0)">
                        <img src="@ImageUrl(articleImage.RelPathWebp, 120, 120)" alt="@(articleImage.Alt)" />
                </a>
            }
        </div>

        <hr />
    
    </article>
    </div>

}
else
{
    <div @(cssClass)>
        <div class="blogwrapper">
            <div class="blogheader">
                [INJECT:appthemesystem,ArticleHeaderView.cshtml]
            <hr class="small-hr" />
            </div>
            <div class="blog">
                @foreach (var articleRowData in articleData.GetRows())
                {
                    if (!articleRowData.GetBool("genxml/checkbox/hiderow"))
                    {
                        var title = articleRowData.Get("genxml/lang/genxml/textbox/title");
                        var detailurl = DetailUrl(moduleData.GetSettingInt("listtabid"), title, articleRowData.RowKey).ToString();
                        var date = articleRowData.GetDate("genxml/textbox/newsdate");
                        var articleImage = articleRowData.GetImage(0);

                        <article>
                        <h2><a href="@(detailurl)">@title</a></h2>
                            <div class="formatdate">
                                <span class="fd-day">@date.ToString("dd")</span>
                                <span class="fd-month">@date.ToString("MMM")</span>
                            </div>
                            <div class="article-img"><img src="@ImageUrl(articleImage.RelPathWebp, moduleData.GetSettingInt("listwidth"), moduleData.GetSettingInt("listheight"))" alt="@(articleImage.Alt)" /></div>
                            <p>@articleRowData.Get("genxml/lang/genxml/textbox/resume")</p>
                            <a class="bigbutton" href="@(detailurl)">@ResourceKey("Articles.readmore")</a>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    $("[data-fancybox]").fancybox({
        lang: 'fr',
        i18n: {
            'fr': {
                CLOSE: 'Fermer',
                NEXT: 'Suivant',
                PREV: 'Précédent',
                ERROR: 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
                PLAY_START: 'Démarrer le diaporama',
                PLAY_STOP: 'Mettre en pause le diaporama',
                FULL_SCREEN: 'Plein écran',
                THUMBS: 'Vignettes',
                DOWNLOAD: 'Télécharger',
                SHARE: 'Partager',
                ZOOM: 'Zoomer'
            }
        }
    });
</script>

