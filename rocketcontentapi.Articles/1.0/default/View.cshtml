@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var articleRow = (ArticleRowLimpet)Model.GetDataObject("articlerow");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();
    var eid = Model.SessionParamsData.GetInt("eid");
    AddProcessDataResx(appThemeView);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");
    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/settings/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass") + "";
    }
}

@if (eid > 0 && articleData.GetRowList().Count >= eid)
{
    var rtnUrl = PagesUtils.NavigateURL(moduleData.Record.GetXmlPropertyInt("genxml/settings/listlinktab"));
    var articleRowData = articleData.GetRow(eid - 1);
    var info = articleRowData.Info;
    var datalist = articleRowData.GetImageList();
    // Changement format de date (dd/MM/yyy)
    var date = info.GetXmlPropertyDate("genxml/textbox/newsdate");
    var dateFormat = date.ToString("dd/MM/yyyy");
    var index = 0;
    var indexMain = 0;
    var group = articleRowData.RowKey;
    <div @(cssClass)>
        <!-- RETURN BTN-->
        <a class="w3-right" href="@rtnUrl">Retour</a>

        <!-- TITLE -->
        <h2>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>

        <!-- MAIN IMAGE -->
        @foreach (var imgInfo in datalist)
        {
            indexMain++;
            var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + @index + "]/hidden/imagealtarticleimage");
            var articleImage = new ArticleImage(imgInfo, "articleimage");
            if (indexMain == 1)
            {
                <img src="@ThumbnailImageUrl(articleImage.RelPath)" />
            }
        }

        <!-- PUBLICATION DATE -->
        <p>Publié le @dateFormat</p>

        <!-- TEXT -->
        @HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))

        <!-- LINKS-->

        @foreach (var linkInfo in articleRow.GetLinkList())
        {
            <div class="newspaper-link">
                @if (linkInfo.GetXmlPropertyInt("genxml/radio/linktypearticlelink") == 1)
                {
                    var tabddlvalue = PagesUtils.NavigateURL(linkInfo.GetXmlPropertyInt("genxml/select/internallinkarticlelink"));
                    var anchor = "";
                    if (linkInfo.GetXmlProperty("genxml/textbox/linkanchorarticlelink") != "")
                    {
                        anchor = "#" + linkInfo.GetXmlProperty("genxml/textbox/linkanchorarticlelink");
                    }
                    <a href="@(tabddlvalue)@(anchor)">@linkInfo.GetXmlProperty("genxml/lang/genxml/textbox/namearticlelink")</a>
                }
                @if (linkInfo.GetXmlPropertyInt("genxml/radio/linktypearticlelink") == 2)
                {
                    var externalURL = linkInfo.GetXmlProperty("genxml/textbox/externallinkarticlelink");
                    var blank = "";
                    if (linkInfo.GetXmlPropertyBool("genxml/checkbox/blankarticlelink"))
                    {
                        blank = "_blank";
                    }
                    <a href="@(externalURL)" target="@(blank)">@linkInfo.GetXmlProperty("genxml/lang/genxml/textbox/namearticlelink")</a>
                }
            </div>
        }


        <!-- DOCUMENTS -->
        @if (!info.GetXmlPropertyBool("genxml/checkbox/documenthiddenarticledoc") && info.GetXmlProperty("genxml/documentlist/genxml/hidden/documentpatharticledoc") != "")
        {
            <div class="about-content">
                @{
                    var docURL = info.GetXmlProperty("genxml/documentlist/genxml/hidden/documentpatharticledoc");
                    <!-- Si on veut afficher le pdf sur un nouvel onglet alors on l'affiche '-->
                    if (info.GetXmlPropertyBool("genxml/checkbox/openinnewtab"))
                    {
                        <div class="documents">
                            <p>@info.GetXmlProperty("genxml/textbox/text")</p>
                            <a href="@(docURL)" target="_blank">
                                @if (info.GetXmlProperty("genxml/textbox/name") != "")
                                {
                                    @info.GetXmlProperty("genxml/textbox/name")
                                }
                                else
                                {
                                    @info.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                                }
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="documents">
                            <p>@info.GetXmlProperty("genxml/textbox/text")</p>
                            <a href="@(docURL)" download="@info.GetXmlProperty("genxml/textbox/documentnamearticledoc")">
                                @if (info.GetXmlProperty("genxml/textbox/name") != "")
                                {
                                    @info.GetXmlProperty("genxml/textbox/name")
                                }
                                else
                                {
                                    @info.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                                }
                            </a>
                        </div>
                    }
                }
            </div>
        }

        <!-- VIDEO -->
        @if (info.GetXmlProperty("genxml/lang/genxml/textbox/video") != "")
        {
            <div class="fcd-video"><div class="video-container">@HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/video"))</div></div>
        }
        <hr />
        <!-- GALLERY -->
        <div class="gallery-wrapper">
            <div class="gallery">
                @foreach (var imgInfo in datalist)
                {
                    index++;
                    var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + @index + "]/hidden/imagealtarticleimage");
                    var articleImage = new ArticleImage(imgInfo, "articleimage");
                    if (articleImage.RelPath != "")
                    {
                        index++;
                        <a data-fancybox="@(group)" data-caption="@(alt)" href="@ThumbnailImageUrl(articleImage.RelPath)">
                            <img src="@ThumbnailImageUrl(articleImage.RelPath, 300, 300)" alt="@(alt)" />
                        </a>
                    }
                }
            </div>
        </div>
        <hr />
    </div>

}
else
{
    <div @(cssClass)>
        <div class="blogwrapper">
            <div class="blogheader">
                @{
                    var headingArticleRowData = (ArticleRowLimpet)Model.GetDataObject("articlerow");
                    var hinfo = headingArticleRowData.Info;
                }
                <!-- HEADER SECTION -->
                @{
                    var headerStyle = articleData.Info.GetXmlProperty("genxml/header/headerstyle");
                    var moduleTitle = articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headertitle");
                }

                @if (headerStyle == "")
                {
                    headerStyle = "h1";
                }
                @if (moduleTitle != "")
                {
                    var headerAlignText = articleData.Info.GetXmlProperty("genxml/header/headeralign");
                    if (headerStyle.ToLower() == "h1")
                    {
                        <h1 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h1>
                    }
                    if (headerStyle.ToLower() == "h2")
                    {
                        <h2 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h2>
                    }
                    if (headerStyle.ToLower() == "h3")
                    {
                        <h3 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h3>
                    }
                    if (headerStyle.ToLower() == "h4")
                    {
                        <h4 id="@articleData.Info.GetXmlProperty("genxml/lang/genxml/header/headeranchor")" style="text-align: @headerAlignText;">@moduleTitle</h4>
                    }
                }
            </div>

            <div class="blog">
                @{var lp = 1;}
                @foreach (var articleRowData in articleData.GetRows())
                {
                    Model.SetDataObject("articlerow", articleRowData);
                    var info = articleRowData.Info;
                    var hStyle = info.GetXmlProperty("genxml/select/headingstyle");
                    var headingHide = info.GetXmlPropertyBool("genxml/checkbox/hideheading");
                    var hideRow = info.GetXmlPropertyBool("genxml/checkbox/hiderow");
                    string[] urlparams = { "eid", lp.ToString(), info.GetXmlProperty("genxml/lang/genxml/textbox/title") };
                    var detailurl = DNNrocketUtils.NavigateURL(moduleData.Record.GetXmlPropertyInt("genxml/settings/linktab"), urlparams);
                    var indexMain = 0;
                    var datalist = articleRowData.GetImageList();

                    if (!hideRow)
                    {
                        <article>
                            @{
                                // Changement format de date (dd/MM/yyy)
                                var date = info.GetXmlPropertyDate("genxml/textbox/newsdate");
                                var dateFormat = date.ToString("dd/MM/yyyy");
                            }
                            <h2>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>
                            <p class="article-infos">Publié le @dateFormat</p>
                            <!-- Affichage de l'image -->
                            @foreach (var imgInfo in datalist)
                            {
                                indexMain++;
                                var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + indexMain + "]/hidden/imagealtarticleimage");
                                var articleImage = new ArticleImage(imgInfo, "articleimage");
                                if (indexMain == 1)
                                {
                                    <img src="@ImageUrl(articleImage.RelPath, moduleData.Record.GetXmlPropertyInt("genxml/settings/width"), moduleData.Record.GetXmlPropertyInt("genxml/settings/height"))" />
                                }
                            }
                            <div class="flexcontent-text">
                                <p>@info.GetXmlProperty("genxml/lang/genxml/textbox/resume")</p>
                            </div>
                            @{
                                lp += 1;
                            }
                            <a href="@(detailurl)">Lire la suite</a>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    $(document).ready(function () {
        simplisity_setSessionField('listurl@(moduleData.ModuleId)', window.location.href); // href to cookie so we can use it on the detail back button.
    });
    $("[data-fancybox]").fancybox({
        lang: 'fr',
        i18n: {
            'fr': {
                CLOSE: 'Fermer',
                NEXT: 'Suivant',
                PREV: 'Précédent',
                ERROR: 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
                PLAY_START: 'Démarrer le diaporama',
                PLAY_STOP: 'Mettre en pause le diaporama',
                FULL_SCREEN: 'Plein écran',
                THUMBS: 'Vignettes',
                DOWNLOAD: 'Télécharger',
                SHARE: 'Partager',
                ZOOM: 'Zoomer'
            }
        }
    });
</script>

