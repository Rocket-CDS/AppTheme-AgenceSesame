@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;

<!-- TODO Rendre ça plus propre - système D pour que ça marche -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.2.5/jquery.fancybox.min.js"></script>

@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();
    var idx = Model.SessionParamsData.GetInt("idx");

    AddProcessDataResx(appThemeView);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketContent/App_LocalResources/");

}
@if (idx > 0 && articleData.GetRowList().Count >= idx)
{
    var rtnUrl = DNNrocketUtils.NavigateURL(Model.SessionParamsData.TabId);
    var articleRowData = articleData.GetRow(idx - 1);
    var info = articleRowData.Info;
    var datalist = articleRowData.GetImageList();
    // Changement format de date (dd/MM/yyy)
    var date = info.GetXmlPropertyDate("genxml/lang/genxml/textbox/newsdate");
    var dateFormat = date.ToString("dd/MM/yyyy");
    var index = 0;
    var indexMain = 0;

    <!-- RETURN BTN-->
    <a class="w3-right" href="@rtnUrl">Retour</a>

    <!-- TITLE -->
    <h2>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>

    <!-- MAIN IMAGE -->
    <!-- TODO Améliorer ce code parce que là c'est une unsine à gaz -->
    foreach (var imgInfo in datalist)
    {
        indexMain++;
        var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + @index + "]/hidden/imagealtarticleimage");
        var articleImage = new ArticleImage(imgInfo, "articleimage");
        if (indexMain == 1)
        {
            <img src="@ThumbnailImageUrl(articleImage.RelPath)" />
        }
    }

    <!-- PUBLICATION DATE -->
    <p>Publié le @dateFormat</p>

    <!-- TEXT -->
    @HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))

    <!-- TODO SHARE BUTTON-->

    <!-- LINKS-->
    <div class="newspaper-link">
        @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 1)
        {
            var tabddlvalue = PagesUtils.NavigateURL(info.GetXmlPropertyInt("genxml/select/linktab"));
            <a href="@(tabddlvalue)#@info.GetXmlProperty("genxml/textbox/linkanchor")">@info.GetXmlProperty("genxml/textbox/linktitle")</a>
        }
        @if (info.GetXmlPropertyInt("genxml/select/rbllink") == 2)
        {
            var externalURL = info.GetXmlProperty("genxml/textbox/externalhref");
            var blank = "";
            if (@info.GetXmlPropertyBool("genxml/checkbox/blank"))
            {
                blank = "_blank";
            }
            <a href="@(externalURL)" target="@(blank)">@info.GetXmlProperty("genxml/textbox/linktitle")</a>
        }
    </div>

    <!-- DOCUMENTS -->
    if (!info.GetXmlPropertyBool("genxml/checkbox/documenthiddenarticledoc") && info.GetXmlProperty("genxml/documentlist/genxml/hidden/documentpatharticledoc") != "")
    {
        <div class="about-content">
            @{
                var docURL = info.GetXmlProperty("genxml/documentlist/genxml/hidden/documentpatharticledoc");
                <!-- Si on veut afficher le pdf sur un nouvel onglet alors on l'affiche '-->
                if (info.GetXmlPropertyBool("genxml/checkbox/openinnewtab"))
                {
                    <div class="documents">
                        <p>@info.GetXmlProperty("genxml/textbox/text")</p>
                        <a href="@(docURL)" target="_blank">
                            @if (info.GetXmlProperty("genxml/textbox/name") != "")
                            {
                                @info.GetXmlProperty("genxml/textbox/name")

                            }
                            else
                            {
                                @info.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                            }
                        </a>
                    </div>
                }
                else
                {
                    <div class="documents">
                        <p>@info.GetXmlProperty("genxml/textbox/text")</p>
                        <a href="@(docURL)" download="@info.GetXmlProperty("genxml/textbox/documentnamearticledoc")">
                            @if (info.GetXmlProperty("genxml/textbox/name") != "")
                            {
                                @info.GetXmlProperty("genxml/textbox/name")
                            }
                            else
                            {
                                @info.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                            }
                        </a>
                    </div>
                }
            }
        </div>
    }

    <!-- VIDEO -->
    if (info.GetXmlProperty("genxml/lang/genxml/textbox/video") != "")
    {
        <div class="fcd-video"><div class="video-container">@HtmlOf(info.GetXmlProperty("genxml/lang/genxml/textbox/video"))</div></div>
    }
    <hr />
    <!-- GALLERY -->
    <div class="article-gallery">
        @foreach (var imgInfo in datalist)
        {
            index++;
            var alt = info.GetXmlProperty("genxml/imagelist/genxml[" + @index + "]/hidden/imagealtarticleimage");
            var articleImage = new ArticleImage(imgInfo, "articleimage");
            if (articleImage.RelPath != "")
            {
                index++;
                <a data-fancybox="1" data-caption="@(alt)" href="@(articleImage.RelPath)">
                    <img src="@ThumbnailImageUrl(articleImage.RelPath)" />
                </a>
            }
        }
    </div>
    <hr />
}
else
{
    <div class="blogwrapper">
        <div class="blogheader">
            <div class="h1-headline">
                @{
                    var headingArticleRowData = (ArticleRowLimpet)Model.GetDataObject("articlerow");
                    var hinfo = headingArticleRowData.Info;
                }
                @hinfo.GetXmlProperty("genxml/lang/genxml/textbox/moduletitle")
            </div>
        </div>

        <div class="blog">
            @{var lp = 1;}
            @foreach (var articleRowData in articleData.GetRows())
            {
                Model.SetDataObject("articlerow", articleRowData);
                var info = articleRowData.Info;
                var hStyle = info.GetXmlProperty("genxml/select/headingstyle");
                var headingHide = info.GetXmlPropertyBool("genxml/checkbox/hideheading");
                var hideRow = info.GetXmlPropertyBool("genxml/checkbox/hiderow");
                string[] urlparams = {"idx", lp.ToString(), info.GetXmlProperty("genxml/lang/genxml/textbox/title") };
                var detailurl = DNNrocketUtils.NavigateURL(Model.SessionParamsData.TabId, urlparams);
                if (!hideRow)
                {
             <article>
                @{
                    // Changement format de date (dd/MM/yyy)
                    var date = info.GetXmlPropertyDate("genxml/lang/genxml/textbox/newsdate");
                    var dateFormat = date.ToString("dd/MM/yyyy");
                }
                <h2>@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</h2>

                <p class="article-infos">Publié le @dateFormat</p>
                <!-- Affichage de l'image -->
                @if (info.GetXmlProperty("genxml/imagelist/genxml["+1+"]/hidden/imagepatharticleimage") != "")
                {
                    <div class="article-img">
                        <img src="@info.GetXmlProperty("genxml/imagelist/genxml["+1+"]/hidden/imagepatharticleimage")" alt="@info.GetXmlProperty("genxml/lang/genxml/textbox/title")" />
                    </div>
                }
                <div class="flexcontent-text">
                    <p>@info.GetXmlProperty("genxml/lang/genxml/textbox/resume")</p>
                </div>

                @{
                    lp += 1;
                }
                <a href="@(detailurl)">Lire la suite</a>
             </article>
                    <hr />
                }
            }
        </div>
    </div>
}

<script>
    $(document).ready(function () {
        simplisity_setSessionField('listurl@(moduleData.ModuleId)', window.location.href); // href to cookie so we can use it on the detail back button.
    });
    $("[data-fancybox]").fancybox({
        lang: 'fr',
        i18n: {
            'fr': {
                CLOSE: 'Fermer',
                NEXT: 'Suivant',
                PREV: 'Précédent',
                ERROR: 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
                PLAY_START: 'Démarrer le diaporama',
                PLAY_STOP: 'Mettre en pause le diaporama',
                FULL_SCREEN: 'Plein écran',
                THUMBS: 'Vignettes',
                DOWNLOAD: 'Télécharger',
                SHARE: 'Partager',
                ZOOM: 'Zoomer'
            }
        }
    });
</script>

