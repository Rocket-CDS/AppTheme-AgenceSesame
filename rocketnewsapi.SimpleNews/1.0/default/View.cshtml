@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI.Components;

<!-- !PAGE CONTENT! -->
<div id="catalog-tag" class="catalog-container">
    @{
        var appTheme = (AppThemeLimpet)Model.GetDataObject("appthemeview");
        var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
        var moduleSettings = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
        if (articleData != null)
        {
            @RenderTemplate("NewsDetail.cshtml", moduleSettings.ModuleRef, appTheme, Model, true)
        }
        else
        {
            @RenderTemplate("NewsList.cshtml", moduleSettings.ModuleRef, appTheme, Model, true)
        }
    }
</div>
<div class="w3-overlay simplisity_loader" style="z-index:999;"></div>
