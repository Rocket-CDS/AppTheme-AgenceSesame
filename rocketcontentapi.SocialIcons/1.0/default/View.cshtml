@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using RocketContentAPI.Components;
@using DNNrocketAPI.Components;
@using RocketPortal.Components;


@{
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeAdmin = (AppThemeLimpet)Model.GetDataObject("appthemeadmin");
    var moduleData = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var globalSettings = new SystemGlobalData();

    var cssClass = "";
    if (moduleData.Record.GetXmlProperty("genxml/setting/cssclass") != "")
    {
        cssClass = "class=" + moduleData.Record.GetXmlProperty("genxml/settings/cssclass");
    }
}

@foreach (var articleRowData in articleData.GetRows())
{
    var info = articleRowData.Info;

    <div @(cssClass)>
        @if (info.GetXmlProperty("genxml/lang/genxml/textbox/title") != "")
        {
            <div class="h4-headline">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</div>
        }

        <div id="@articleRowData.RowKey" class="socialicons si-colored">
            @if (info.GetXmlProperty("genxml/textbox/twitter") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/twitter")" class="twittericon" target="_blank"><span class="ri-twitter"></span></a>
            }

            @if (info.GetXmlProperty("genxml/textbox/linkedin") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/linkedin")" class="linkedinicon" target="_blank"><span class="ri-linkedin"></span></a>
            }

            @if (info.GetXmlProperty("genxml/textbox/facebook") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/facebook")" class="facebookicon" target="_blank"><span class="ri-facebook"></span></a>
            }
            @if (info.GetXmlProperty("genxml/textbox/youtube") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/youtube")" class="youtubeicon" target="_blank"><span class="ri-youtube"></span></a>
            }
            @if (info.GetXmlProperty("genxml/textbox/pinterest") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/pinterest")" class="pinteresticon" target="_blank"><span class="ri-pinterest"></span></a>
            }
            @if (info.GetXmlProperty("genxml/textbox/instagram") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/instagram")" class="instagramicon" target="_blank"><span class="ri-instagram"></span></a>
            }
            @if (info.GetXmlProperty("genxml/textbox/tripadvisor") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/tripadvisor")" class="tripadvisoricon" target="_blank"><span class="ri-tripadvisor"></span></a>
            }
            @if (info.GetXmlProperty("genxml/textbox/rss") != "")
            {
                <a href="@info.GetXmlProperty("genxml/textbox/rss")" class="rssicon" target="_blank"><span class="ri-rss"></span></a>
            }
        </div>
    </div>
}


