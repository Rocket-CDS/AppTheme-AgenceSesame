@inherits RocketContentAPI.Components.RocketContentAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketContentAPI.Components;
@AssignDataModel(Model)
@AddProcessDataResx(appThemeView, true)
<!--inject-->

@{
    var openDiv = "";
    var closeDiv = "";
    if (moduleData.GetSetting("cssclass") != "")
    {
        openDiv = "<div class='" + moduleData.GetSetting("cssclass") + "'>";
        closeDiv = "</div>";
    }
}

@HtmlOf(openDiv)
    @if (info.GetXmlProperty("genxml/lang/genxml/textbox/title") != "")
    {
        <div class="h4-headline">@info.GetXmlProperty("genxml/lang/genxml/textbox/title")</div>
    }
    <div id="@articleRowData.RowKey" class="socialicons si-colored">
        @LinkURL(info, "genxml/textbox/facebook", true, "<span class='ri-facebook'></span><span class='ri-sr-only'>Facebook</span>", " class='facebookicon' title='Facebook' target='_blank' ")
        @LinkURL(info, "genxml/textbox/linkedin", true, "<span class='ri-linkedin'></span><span class='ri-sr-only'>LinkedIn</span>", " class='linkedinicon' title='LinkedIn' target='_blank' ")
        @LinkURL(info, "genxml/textbox/instagram", true, "<span class='ri-instagram'></span><span class='ri-sr-only'>Instagram</span>", " class='instagramicon' title='Instagram' target='_blank' ")
        @LinkURL(info, "genxml/textbox/youtube", true, "<span class='ri-youtube-play'></span><span class='ri-sr-only'>YouTube</span>", " class='youtubeicon' title='YouTube' target='_blank' ")
        @LinkURL(info, "genxml/textbox/twitter", true, "<span class='ri-x'></span><span class='ri-sr-only'>X</span>", " class='twittericon' title='X' target='_blank' ")
        @LinkURL(info, "genxml/textbox/pinterest", true, "<span class='ri-pinterest'></span><span class='ri-sr-only'>Pinterest</span>", " class='pinteresticon' title='Pinterest' target='_blank' ")
        @LinkURL(info, "genxml/textbox/tripadvisor", true, "<span class='ri-tripadvisor'></span><span class='ri-sr-only'>TripAdvisor</span>", " class='tripadvisoricon' title='TripAdvisor' target='_blank' ")
        @LinkURL(info, "genxml/textbox/messenger", true, "<span class='ri-messenger'></span><span class='ri-sr-only'>Messenger</span>", " class='messengericon' title='Messenger' target='_blank' ")
        @LinkURL(info, "genxml/textbox/rss", true, "<span class='ri-rss'></span><span class='ri-sr-only'>RSS</span>", " class='rssicon' title='RSS' target='_blank' ")
    </div>
@HtmlOf(closeDiv)