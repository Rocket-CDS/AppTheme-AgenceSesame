@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;

@{ 
    var appTheme = (AppThemeLimpet)Model.GetDataObject("apptheme");
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
}

<div class="pageflex">
    <div id="a-filtercontainer" class="leftpane">
        @RenderTemplate("Filters.cshtml", appTheme, Model, true)
    </div>
    <div id="a-articlecontainer" class="contentpane2">
        @if (articleData != null)
        {@RenderTemplate("ArticleDetail.cshtml", appTheme, Model, false)}
        else 
        {@RenderTemplate("ArticleList.cshtml", appTheme, Model, false)}
    </div>
</div>

<div class="simplisity_loader" style="display:none;">
    <span class=" simplisity_loader_inner">
    </span>
</div>

