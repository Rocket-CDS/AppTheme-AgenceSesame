@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using Simplisity;
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI.Components;

@AddProcessData("resourcepath", "/DesktopModules/DNNrocket/api/App_LocalResources/")
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")
@{
    var info = new SimplisityInfo();
    var propertyData = (PropertyLimpet)Model.List.First();
    if (propertyData.Info != null)
    {
        info = propertyData.Info;
    }
}
<!--inject-->

<div class='w3-col w3-padding'>
    <label>@ResourceKey("DNNrocket.email")</label>
    @TextBox(info, "genxml/textbox/referentemail", " class='w3-input w3-border' autocomplete='off' ", "", false, 0)
</div>