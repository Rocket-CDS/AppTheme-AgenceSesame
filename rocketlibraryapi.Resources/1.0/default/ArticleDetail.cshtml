@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;

@{
    var sessionParams = (SessionParams)Model.SessionParamsData;
    var articleData = (ArticleLimpet)Model.GetDataObject("articledata");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var categoryList = (CategoryLimpetList)Model.GetDataObject("categorylist");
    var appTheme = (AppThemeLimpet)Model.GetDataObject("appthemeview");
    var appThemeDefault = (AppThemeLimpet)Model.GetDataObject("appthemedefault");
    var appThemeDirectory = (AppThemeSystemLimpet)Model.GetDataObject("appthemedirectory");
    var appThemeDirectoryDefault = (AppThemeLimpet)Model.GetDataObject("appthemedirectorydefault");
    var catalogSettings = (CatalogSettingsLimpet)Model.GetDataObject("catalogsettings");
    var propertyList = (PropertyLimpetList)Model.GetDataObject("propertylist");
    var propertyCheckboxes = new List<PropertyLimpet>();
    var nodList = false;
    var appThemeView = (AppThemeLimpet)Model.GetDataObject("appthemeview");

    AddProcessDataResx(appThemeView, true);
}
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")

<div class="articledetail">

                <div class="articledetail-back">
                    @{
                        var returnUrl = "";
                        if (sessionParams.GetInt("catid") > 0)
                        {
                            var categoryData = new CategoryLimpet(portalData.PortalId, sessionParams.GetInt("catid"), sessionParams.CultureCode, "");
                            var urlparams = new Dictionary<string, string>();
                            urlparams.Add("catid", categoryData.CategoryId.ToString());
                            returnUrl = DNNrocketUtils.NavigateURL(sessionParams.TabId, urlparams, categoryData.Name);;
                        }
                        else
                        {
                            returnUrl = DNNrocketUtils.NavigateURL(sessionParams.TabId);;                
                        }
                    }
                    <a href="@returnUrl" class="bigbutton"><i class="fas fa-angle-left"></i>@ResourceKey("Theme.back", sessionParams.CultureCode)</a>
                </div>

                <div class="articledetailflex">

                    <div class="articledetail-left">

                        <div class="image">
                            <img class="imgrollovertarget has-ratio" alt="@articleData.Name" src="@ImageUrl(articleData.GetImage(0).RelPath,640,0)" />
                        </div>

                        <h1 class="title">@articleData.Name</h1>

                        @if (articleData.GetProperties().Count > 0)
                        {
                            <p class="subtitle">@articleData.GetProperties().First().Name</p>
                        }
                        
                        <div class="articledetail-section">@BreakOf(articleData.Summary)</div>

                        <div>@HtmlOf(articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))</div>
                        
                        <div class="articledetail-section"><a href="/fr-fr/a-table-" class="bigbutton linebutton">@ResourceKey("Theme.carte", sessionParams.CultureCode)</a></div>

                        @if (articleData.GetImages().Count > 1)
                        {
                        <div class="articledetail-section articlegallery">
                            @{var imgLp = 1;}
                            @foreach (var i in articleData.GetImages())
                            {
                            <a data-fancybox="gallery" data-caption="" href="@ImageUrl(i.RelPath,640,0)">
                            <img src="@ImageUrl(i.RelPath,120,0)" alt="" />
                            </a>
                            
                            }
                        </div>
                        }

                    </div>

                    <div class="articledetail-right">

                        <div class="articledetail-section">
                            <div class="h3-headline"><i class="far fa-user-circle fa-lg"></i>@ResourceKey("Theme.contact", sessionParams.CultureCode)</div>
                            <div class="block">
                                <h4>@articleData.Name</h4>
                                @if (articleData.Info.GetXmlProperty("genxml/textbox/phone") != "")
                                {
									var clictel = articleData.Info.GetXmlProperty("genxml/textbox/mobile");
                                    <br />@ResourceKey("Theme.tel", sessionParams.CultureCode) <a href="tel:@clictel">@articleData.Info.GetXmlProperty("genxml/textbox/phone")</a>
                                }
                                @if (articleData.Info.GetXmlProperty("genxml/textbox/email") != "")
                                {
                                    <br />@ResourceKey("Theme.email", sessionParams.CultureCode) <span>:</span> @EmailOf(articleData.Info, "genxml/textbox/email")
                                }
                            </div>
                        </div>

                        @if (articleData.Getlinks().Count > 0 || articleData.GetDocs().Count > 0)
                        {
                            <div class="articledetail-section" id="linklistcontainer">
                                <div class="h3-headline"><i class="far fa-file-alt fa-lg"></i>@ResourceKey("Theme.linksdownloads", sessionParams.CultureCode)</div>
                                <div class="docslinks">
                                @foreach (var lk in articleData.Getlinks())
                                {
                                    if (!lk.Hidden)
                                    {
                                        <a target="_blank" href="@lk.Url" class="panel-block">
                                            <i class="fas fa-link" aria-hidden="true"></i>@lk.Name
                                        </a>
                                    }
                                }
                                @foreach (var doc in articleData.GetDocList())
                                {
                                    <a target="_blank" href="/@doc.GetXmlProperty("genxml/hidden/documentpatharticledoc")" class="panel-block">
                                        <i class="fas fa-file-pdf" aria-hidden="true"></i>@doc.GetXmlProperty("genxml/textbox/documentnamearticledoc")
                                    </a>
                                }
                                </div>
                            </div>
                        }

                    </div>

                </div>

<script>

    $(document).ready(function () {

        $('.returnlink').unbind('click');
        $('.returnlink').on('click', function (e) {
            $('#simplisity_loader').show();
            simplisity_setSessionField('searchtext', '');
        });
        $('.navgocolink').unbind('click');
        $('.navgocolink').on('click', function (e) {
            $('#simplisity_loader').show();
            simplisity_setSessionField('searchtext', '');
        });

    });

    $("[data-fancybox]").fancybox({
    lang : 'fr',
    i18n : {
        'fr' : {
            CLOSE       : 'Fermer',
            NEXT        : 'Suivant',
            PREV        : 'Précédent',
            ERROR       : 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
            PLAY_START  : 'Démarrer le diaporama',
            PLAY_STOP   : 'Mettre en pause le diaporama',
            FULL_SCREEN : 'Plein écran',
            THUMBS      : 'Vignettes',
            DOWNLOAD    : 'Télécharger',
            SHARE       : 'Partager',
            ZOOM        : 'Zoomer'
        }
    }
    });

    function setSessionParams() {
        simplisity_setSessionField('searchtext', $('#searchtext').val());
        $('#simplisity_loader').show();
        window.location.href = '';
    }

</script>

</div>
