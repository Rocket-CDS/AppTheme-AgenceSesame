@inherits RocketLibraryAPI.Components.RocketLibraryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using System.Globalization;
@using Simplisity;
@AssigDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->
@{
    var nodList = false;
    var date = articleData.Info.GetXmlPropertyDate("genxml/textbox/publisheddate");
    var dateFormat = date.ToString("dd/MM/yyyy");
    AddProcessDataResx(appTheme, true);
}

<div class="articledetail">

                <div class="articledetail-back">
                    @{
                        var returnUrl = "";
                        if (sessionParams.GetInt("catid") > 0)
                        {
                            var categoryData = new CategoryLimpet(portalData.PortalId, sessionParams.GetInt("catid"), sessionParams.CultureCode, "");
                            var urlparams = new Dictionary<string, string>();
                            urlparams.Add("catid", categoryData.CategoryId.ToString());
                            returnUrl = DNNrocketUtils.NavigateURL(sessionParams.TabId, urlparams, categoryData.Name);;
                        }
                        else
                        {
                            returnUrl = DNNrocketUtils.NavigateURL(sessionParams.TabId);;                
                        }
                    }
                    <a href="@returnUrl" class="bigbutton"><i class="fas fa-angle-up"></i>@ResourceKey("Theme.back", sessionParams.CultureCode)</a>
                </div>

                <div class="articledetailflex">

                    <div class="articledetail-left">

                        <h1 class="title">@articleData.Name</h1>

                        @if (articleData.Info.GetXmlPropertyBool("genxml/checkbox/internal"))
                        {
                        <div class="article-infos">
                            <div class="article-internal">Document interne</div>
                        </div>
                        }

                        <div class="articledetail-section article-tags">
                            @foreach (var p in articleData.GetProperties())
                            {
                                if (p.IsInGroup("thematique"))
                                {
                                <span>@p.Name</span>
                                }
                            }
                        </div>

                        @if (articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/articlesummary") != "")
                        {
                        <div class="articledetail-section summary">@BreakOf(articleData.Summary)</div>
                        }

                        <div class="articledetail-section">
                        <div class="article-infos">
                            <div>
                                <span>Auteur(s) :</span>
                                @foreach (var p in articleData.GetProperties())
                                {
                                    if (p.IsInGroup("auteur"))
                                    {
                                    <span class="commalist">@p.Name</span>
                                    }
                                }
                            </div>
                            <div class="sep">|</div>
                            <div>@ResourceKey("Theme.publicationdate", sessionParams.CultureCode) : @dateFormat</div>
                            <div class="sep">|</div>
                            <div>
                                <span>Type(s) de document :</span>
                                @foreach (var p in articleData.GetProperties())
                                {
                                    if (p.IsInGroup("type"))
                                    {
                                    <span class="commalist">@p.Name</span>
                                    }
                                }
                            </div>
                        </div>
                        <div class="article-markers">
                            @foreach (var p in articleData.GetProperties())
                            {
                                if (p.IsInGroup("territoire"))
                                {
                                <span class="commalist">@p.Name</span>
                                }
                            }
                        </div>
                        </div>

                        @if (articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/richtext") != "")
                        {
                        <div class="articledetail-section">
                            <div><strong>En savoir plus :</strong></div>
                            @HtmlOf(articleData.Info.GetXmlProperty("genxml/lang/genxml/textbox/richtext"))
                        </div>
                        }

                        <div class="articledetail-section">
                            <div class="article-infos">
                                <div>Dernière modification : @articleData.Info.ModifiedDate.ToString("d")</div>
                            </div>
                        </div>

                        @if (articleData.GetImages().Count > 1)
                        {
                        <div class="articledetail-section articlegallery">
                            @{var imgLp = 1;}
                            @foreach (var i in articleData.GetImages())
                            {
                            <a data-fancybox="gallery" data-caption="" href="@ImageUrl(i.RelPath,640,0)">
                            <img src="@ImageUrl(i.RelPath,120,0)" alt="" />
                            </a>
                            
                            }
                        </div>
                        }

                    </div>

                    <div class="articledetail-right">

                        <div class="articledetail-section image">
                            <img alt="@articleData.Name" src="@ImageUrl(articleData.GetImage(0).RelPath,300,0)" />
                        </div>

                        <div class="articledetail-section">
                            <div class="ads-icon"><i class="far fa-user-circle fa-lg"></i></div>
                            <div class="h4-headline">Référent</div>
                            @foreach (var p in articleData.GetProperties())
                            {
                                if (p.IsInGroup("referent"))
                                {
                                <strong>@p.Name</strong>
                                <div class="referent-desc">
                                    <div>@p.Summary</div>
                                    <div>@EmailOf(p.Info, "genxml/textbox/referentemail")</div>
                                </div>
                                }
                            }
                        </div>

                        @if (articleData.Getlinks().Count > 0 || articleData.GetDocs().Count > 0)
                        {
                            <div class="articledetail-section simplisity_panel" id="linklistcontainer">
                                <div class="ads-icon"><i class="far fa-file-alt fa-lg"></i></div>
                                <div class="h4-headline">Ressources</div>

                                @if (!UserUtils.IsAuthorised())
                                {
                                <div class="article-infos article-alert">
                                    Vous devez être connecté à votre espace adhérent ou créer un compte pour accéder aux ressources.
                                    <a href="/login?returnurl=%2fbase-documentaire%2farticleid%2f@(articleData.ArticleId)" class="bigbutton">Se connecter</a>
                                </div>
                                }
                                
                                <div class="article-docs">
                                @foreach (var lk in articleData.Getlinks())
                                {
                                    if (!lk.Hidden)
                                    {
                                        if (UserUtils.IsAuthorised())
                                        {
                                            <a target="_blank" href="@lk.Url" class="panel-block">
                                                <i class="fas fa-link fa-fw" aria-hidden="true"></i>@lk.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="panel-block">
                                                <i class="fas fa-link fa-fw" aria-hidden="true"></i>@lk.Name
                                            </span>
                                        }
                                    }
                                }
                                @foreach (var doc in articleData.GetDocs())
                                {
                                    if (UserUtils.IsAuthorised())
                                    {
                                        <a class="panel-block simplisity_filedownload" s-cmd="remote_publicdownload" s-fields='{"articleid":"@(articleData.ArticleId.ToString())","dockey":"@(doc.DocKey)"}'>
                                            <i class="fas fa-file-pdf fa-fw" aria-hidden="true"></i>@doc.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="panel-block">
                                            <i class="fas fa-file-pdf fa-fw" aria-hidden="true"></i>@doc.Name
                                        </span>
                                    }
                                }
                                </div>
                            </div>
                        }

                    </div>

                </div>

<script>

    $(document).ready(function () {

        $('.returnlink').unbind('click');
        $('.returnlink').on('click', function (e) {
            $('#simplisity_loader').show();
            simplisity_setSessionField('searchtext', '');
        });
        $('.navgocolink').unbind('click');
        $('.navgocolink').on('click', function (e) {
            $('#simplisity_loader').show();
            simplisity_setSessionField('searchtext', '');
        });

        $(document).simplisityStartUp('/Desktopmodules/dnnrocket/api/rocket/action', { "systemkey": "@(articleData.SystemKey)"});
        $('#simplisity_loader').hide();

    });

    $("[data-fancybox]").fancybox({
    lang : 'fr',
    i18n : {
        'fr' : {
            CLOSE       : 'Fermer',
            NEXT        : 'Suivant',
            PREV        : 'Précédent',
            ERROR       : 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
            PLAY_START  : 'Démarrer le diaporama',
            PLAY_STOP   : 'Mettre en pause le diaporama',
            FULL_SCREEN : 'Plein écran',
            THUMBS      : 'Vignettes',
            DOWNLOAD    : 'Télécharger',
            SHARE       : 'Partager',
            ZOOM        : 'Zoomer'
        }
    }
    });

    function setSessionParams() {
        simplisity_setSessionField('searchtext', $('#searchtext').val());
        $('#simplisity_loader').show();
        window.location.href = '';
    }

</script>

</div>