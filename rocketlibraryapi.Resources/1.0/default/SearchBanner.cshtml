﻿@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;

@AddProcessData("resourcepath", "/DesktopModules/DNNrocket/api/App_LocalResources/")
@AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/")

@{
    var sessionParams = (SessionParams)Model.SessionParamsData;
    var portalContent = (PortalCatalogLimpet)Model.GetDataObject("portalcontent");
    var articleDataList = (ArticleLimpetList)Model.GetDataObject("articlelist");
    var categoryData = (CategoryLimpet)Model.GetDataObject("categorydata");
}

<div class="searchbar searchdata">
    <div class="searchbar-item">
        <div class="searchbar-label">Par mots-clés</div>
        <div class="searchbar-input">
            @TextBox(new SimplisityInfo(), "genxml/textbox/viewsearchtext", " class='simplisity_sessionfield actionentrykey searchinput' autocomplete='off' ", sessionParams.Get("viewsearchtext"))
        </div>
    </div>
    <div class="searchbar-item">
        <div class="searchbar-label">Par date</div>
        <div class="searchbar-daterange">
            <div class="searchbar-input searchbar-item">
                <div class="searchbar-inputpre">Du :</div>
                @TextBox(new SimplisityInfo(), "genxml/textbox/searchdate1", " class='simplisity_sessionfield dateinput' autocomplete='off' ", sessionParams.Get("searchdate1"), false, 0, "","date")
            </div>
            <div class="searchbar-input searchbar-item">
                <div class="searchbar-inputpre">Au :</div>
                @TextBox(new SimplisityInfo(), "genxml/textbox/searchdate2", " class='simplisity_sessionfield dateinput' autocomplete='off' ", sessionParams.Get("searchdate2"), false, 0, "","date")
            </div>
            <span class="searchbar-btn clearsearch" style="display:none;" onclick="clearSearch();return false;">@ButtonIcon(ButtonTypes.cancel)</span>
            <span class="searchbar-btn simplisity_click dosearch" onclick="doSearchReload();return false;">@ButtonIcon(ButtonTypes.search)</span>
        </div>
    </div>
</div>

<div class="a-filtercheckedtags"></div>

<script>

    $(document).ready(function () {
        if ($('.actionentrykey').val() !== '' || $('#searchdate1').val() !== '' || $('#searchdate2').val() !== '') {
            $('.actionentrykey').focus();
            $('.clearsearch').show();
            $('.dosearch').hide();
            var tmpStr = $('.actionentrykey').val();
            $('.actionentrykey').val('');
            $('.actionentrykey').val(tmpStr);
            $('#viewsearchtext').addClass('w3-theme-light');
        }
        else {
            $('#viewsearchtext').removeClass('w3-theme-light');
            $('.clearsearch').hide();
            $('.dosearch').show();
        }

        $('.actionentrykey').unbind('keypress');
        $('.actionentrykey').on('keypress', function (e) {
            if (e.keyCode == 13) {
                doSearchReload();
                return false; // prevent the button click from happening
            }
        });
        showCheckedTags();
    });

    function showCheckedTags() {
        var sList = "";
        $('.rocket-filtercheckbox').each(function () {
            if ($(this).is(":checked")) {
                var trig = "$('#" + $(this).attr('id') + "').trigger('click');"
                sList += '<span class="selectedfiltertags" onclick="' + trig + '">' + $(this).attr('propertyname') + '</span>';
            }
        });
        $('.a-filtercheckedtags').html(sList);
    }

    function clearSearch() {
        $('#viewsearchtext').val('');
        $('#searchdate1').val('');
        $('#searchdate2').val('');
        doSearchReload();
    }

    function doSearchReload() {
        simplisity_setSessionField('viewsearchtext', $('#viewsearchtext').val());
        simplisity_setSessionField('searchdate1', $('#searchdate1').val());
        simplisity_setSessionField('searchdate2', $('#searchdate2').val());
        simplisity_setSessionField('pagesize', $('#pagesize').val());
        simplisity_setSessionField('orderbyref', $('#orderbyref').val());
        $('.simplisity_loader').show();
        @{
        var urlparams = new Dictionary<string, string>();
        urlparams.Add("page", "1");
        }
        window.location.href = '@(DNNrocketUtils.NavigateURL(sessionParams.TabId, urlparams))';
    }

</script>