@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;

@{
    var sessionParams = (SessionParams)Model.SessionParamsData;
    var moduleSettings = (ModuleContentLimpet)Model.GetDataObject("modulesettings");
    var portalData = (PortalLimpet)Model.GetDataObject("portaldata");
    var portalCatalog = (PortalCatalogLimpet)Model.GetDataObject("portalcatalog");
    var appTheme = (AppThemeLimpet)Model.GetDataObject("apptheme");
    var catalogSettings = (CatalogSettingsLimpet)Model.GetDataObject("catalogsettings");

    var groupDict = catalogSettings.GetPropertyGroups();
    var info = new SimplisityInfo(moduleSettings.Record);

    AddProcessDataResx(appTheme, true);
    AddProcessData("resourcepath", "/DesktopModules/DNNrocketModules/RocketDirectoryAPI/App_LocalResources/");

    //NOTE: xPath for module settings must use "genxml/settings/*"
}

<div class='w3-row'>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.width")</label>
        @TextBox(info, "genxml/settings/mapwidth", " class='w3-input w3-border'", "96%")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.height")</label>
        @TextBox(info, "genxml/settings/mapheight", " class='w3-input w3-border'", "700px")
    </div>
    <div class="w3-quarter w3-padding">
        <label>@ResourceKey("DNNrocket.pagesize")</label>
        @DropDownList(info, "genxml/settings/pagesize", "10,12,24,48,96", "10,12,24,48,96", " style='height:40px;' class='w3-input w3-border simplisity_sessionfield ' onchange=\"doSearchReload();return false;\" title='" + @ResourceKey("DNNrocket.pagesize", sessionParams.CultureCode) + "'", "24")
    </div>
</div>

<div class="w3-row  w3-padding">
    <div class="w3-row">
        <div class='w3-row w3-padding'>
            <div class="w3-large w3-margin-bottom">@ResourceKey("RC.propertygroups")</div>
            @foreach (var p in groupDict)
            {
                <span class="w3-padding">
                    @CheckBox(info, "genxml/settings/propertygroup-" + p.Key.ToLower(),p.Value," class='w3-check' ")
                </span>
            }
        </div>
    </div>
</div>


<script>

    $(document).ready(function () {
    });

</script>
