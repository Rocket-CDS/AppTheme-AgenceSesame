@inherits RocketLibraryAPI.Components.RocketLibraryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using System.Globalization;
@using Simplisity;
@AssigDataModel(Model)
@AddProcessDataResx(appTheme, true)
<!--inject-->

<div class="articlewrapper">

    <div class="h1-headline">Rechercher un document</div>

    @RenderTemplate("SearchBanner.cshtml", appTheme, Model, false)

    @if (articleDataList.GetArticleList().Count > 0)
    {
<div class="articlelist">

    @foreach (ArticleLimpet articleData2 in articleDataList.GetArticleList())
    {
        var urlparams = new Dictionary<string, string>();
        urlparams.Add("articleid", articleData2.ArticleId.ToString());
        var hreflink = DNNrocketUtils.NavigateURL(sessionParams.TabId, urlparams, articleData2.Name);
        var date = articleData2.Info.GetXmlPropertyDate("genxml/textbox/publisheddate");
        var dateFormat = date.ToString("dd/MM/yyyy");

<div class="article">
    <div class="article-image">
        <a href="@(hreflink)" title="@articleData2.Name" onclick="$('#simplisity_loader').show();">
            <img src="@ImageUrl(articleData2.GetImage(0).RelPath,120,0)" alt="@articleData2.GetImage(0).Alt" />
        </a>
    </div>
    <div class="article-content">
        <h2><a href="@(hreflink)" title="@articleData2.Name" onclick="$('#simplisity_loader').show();">@articleData2.Name</a></h2>
        @if (articleData2.Info.GetXmlPropertyBool("genxml/checkbox/internal"))
        {
        <div class="article-infos">
            <div class="article-internal">Document interne</div>
        </div>
        }
        <div class="article-tags">
            @foreach (var p in articleData2.GetProperties())
            {
                if (p.IsInGroup("thematique"))
                {
<span>@p.Name</span>    }
}
        </div>
        <div class="article-summary truncate">@BreakOf(articleData2.Summary)</div>
        <div class="article-infos">
            <div>
                <span>Auteur(s) :</span>
                @foreach (var p in articleData2.GetProperties())
                {
                    if (p.IsInGroup("auteur"))
                    {
<span class="commalist">@p.Name</span>}
}
            </div>
            <div class="sep">|</div>
            <div>@ResourceKey("Theme.publicationdate", sessionParams.CultureCode) : @dateFormat</div>
            <div class="sep">|</div>
            <div>
                <span>Type(s) de document :</span>
                @foreach (var p in articleData2.GetProperties())
                {
                    if (p.IsInGroup("type"))
                    {
<span class="commalist">@p.Name</span>}
}
            </div>
        </div>
        <div class="article-markers">
            @foreach (var p in articleData2.GetProperties())
            {
                if (p.IsInGroup("territoire"))
                {
<span class="commalist">@p.Name</span>}
}
        </div>
    </div>
</div>
}

</div>

                @RenderTemplate("articlePaging.cshtml", appTheme, Model, false) }
            else
            {
<div class="h2-headline">Aucun résultat</div>}

</div>

<script>

    $(document).ready(function () {

        $(function () {
            $('.truncate').succinct({
                size: 200
            });
        });

    });

</script>