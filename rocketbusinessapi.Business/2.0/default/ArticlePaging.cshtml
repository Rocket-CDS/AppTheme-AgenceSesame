@inherits RocketDirectoryAPI.Components.RocketDirectoryAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI.Components;
@AssignDataModel(Model)
<!--inject-->
@{
    var rowcount = articleDataList.SessionParamData.RowCount;
    var page = articleDataList.SessionParamData.Page;
    var pagesize = articleDataList.SessionParamData.PageSize;
    var pagechapter = 5;
    var lastpage = 0;
    var catid = articleDataList.CategoryId;
    var catUrlKey = RocketDirectoryAPIUtils.UrlQueryCategoryKey(portalContent.PortalId, portalContent.SystemKey);

    var r = (page - 1) / pagechapter;
    var BeginPage = 0;
    var EndPage = 0;

    if (pagesize > 0)
    {
        lastpage = System.Convert.ToInt32(rowcount / pagesize);
        if (rowcount % pagesize > 0)
        {
            lastpage += 1;
        }
        BeginPage = pagechapter * r + 1;
        EndPage = Math.Min(pagechapter * (r + 1), lastpage);
    }

}

@functions {

    private string PagingUrl(int tabid, int pagenumber, int catid, string catUrlKey)
    {
        if (catid > 0)
        {
            return DNNrocketUtils.NavigateURL(tabid, new Dictionary<string, string>() { { catUrlKey, catid.ToString() }, { "page", pagenumber.ToString() } });
        }
        else
        {
            return DNNrocketUtils.NavigateURL(tabid, new Dictionary<string, string>() { { "page", pagenumber.ToString() } });
        }
    }

}

@if (pagesize > 0 && lastpage > 1)
{
    <nav class="pagination is-centered" role="navigation">

            @if (BeginPage != 1)
            {
                <a href="@PagingUrl(sessionParams.TabId, 1, catid, catUrlKey)" class="pagination-previous" onclick="$('.simplisity_loader').show()"><i class="fas fa-step-backward"></i></a>
            }

            @if (page < lastpage)
            {
                <a href="@PagingUrl(sessionParams.TabId, lastpage, catid, catUrlKey)" class="pagination-next" onclick="$('.simplisity_loader').show()"><i class="fas fa-step-forward"></i></a>
            }

            <ul class="pagination-list">
            @if (page >= 6)
            {
                <li><a href="@PagingUrl(sessionParams.TabId, (BeginPage - 1), catid, catUrlKey)" class="pagination-link" onclick="$('.simplisity_loader').show()"><i class="fas fa-ellipsis-h"></i></a></li>
            }
            @for (int i = BeginPage; i < (EndPage + 1); i++)
            {
                var selected = "";
                if (i == page)
                {
                    selected = "is-current";
                }
                if (i <= lastpage)
                {
                    <li><a href="@PagingUrl(sessionParams.TabId, i, catid, catUrlKey)" class="pagination-link @selected" onclick="$('.simplisity_loader').show()">@(i)</a></li>
                }
            }
            @if (EndPage != lastpage)
            {
                <li><a href="@PagingUrl(sessionParams.TabId, (EndPage + 1), catid, catUrlKey)" class="pagination-link" onclick="$('.simplisity_loader').show()"><i class="fas fa-ellipsis-h"></i></a></li>
            }
            </ul>

    </nav>
}