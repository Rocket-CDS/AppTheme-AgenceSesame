@inherits RocketBusinessAPI.Components.RocketBusinessAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using RocketBusinessAPI.Components;
@AssigDataModel(Model)

<!--inject-->

<div class="searchdata">

    <div class="searchbox">
        @TextBox(infoempty, "genxml/textbox/searchtext", " class='simplisity_sessionfield actionentrykey' autocomplete='off' disabled ", sessionParams.Get("searchtext"))
        <span class="clearsearch" onclick="clearSearch();return false;"><i class="fas fa-times"></i></span>
        <span class="simplisity_click dosearch" style="display:none;" onclick="doSearchReload();return false;">@ButtonIcon(ButtonTypes.search)</span>
    </div>

    <div class="a-filtercheckedtags"></div>

@{
    var orderbyDictionary = new Dictionary<string, string>();
    foreach (var orderbyInfo in portalContent.GetProductOrderByList())
    {
        orderbyDictionary.Add(orderbyInfo.GetXmlProperty("genxml/key"), ResourceKey("RC." + orderbyInfo.GetXmlProperty("genxml/key"), sessionParams.CultureCode).ToString());
    }
    if (orderbyDictionary.Count > 1)
    {
        <div class="rocket-sort">
            <div class="control">
                <div class="select is-primary">@DropDownList(infoempty, "genxml/hidden/orderbyref", orderbyDictionary, " class='simplisity_sessionfield' onchange=\"doSearchReload();return false;\"", sessionParams.Get("orderbyref"))</div>
            </div>
        </div>
    }
}

</div>

<div class="simplisity_loader">
    <span class=" simplisity_loader_inner"></span>
</div>

<script>

    $(document).ready(function () {
        if ($('.actionentrykey').val() !== '') {
            $('.searchbox').show();
        }
        else {
            $('.searchbox').hide();
        }
        $('.simplisity_loader').hide();

        $('.actionentrykey').unbind('keypress');
        $('.actionentrykey').on('keypress', function (e) {
            if (e.keyCode == 13) {
                doSearchReload();
                return false; // prevent the button click from happening
            }
        });

        simplisity_setSessionField('searchtext', $('#searchtext').val()); // we need to repopulate the session cookie if the DNN search has been used.

        showCheckedTags();

        $(".rocket-filtercheckbox").on("change", function() {
          showCheckedTags();
        } );

    });

    function showCheckedTags() {
        var sList = "";
        $('.rocket-filtercheckbox').each(function () {
            if ($(this).is(":checked"))
            {
                var trig = "$('#" + $(this).attr('id') + "').trigger('click');"
                sList += '<span class="selectedfiltertags" onclick="' + trig +'">' + $(this).attr('propertyname') + '</span>';
            }
        });
        $('.a-filtercheckedtags').html(sList);
    }

    function clearSearch() {
        $('#searchtext').val('');
        doSearchReload();
    }

    function doSearchReload() {
        simplisity_setSessionField('searchtext', $('#searchtext').val());
        simplisity_setSessionField('pagesize', $('#pagesize').val());
        simplisity_setSessionField('orderbyref', $('#orderbyref').val());
        $('.simplisity_loader').show();
        @{
        var urlp = new Dictionary<string, string>();
        urlp.Add("page", "1");
        }
            window.location.href = '@(DNNrocketUtils.NavigateURL(sessionParams.TabId, urlp))';
    }

</script>