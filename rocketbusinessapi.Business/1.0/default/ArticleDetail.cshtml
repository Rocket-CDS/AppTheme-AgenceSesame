@inherits RocketBusinessAPI.Components.RocketBusinessAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using RocketBusinessAPI.Components;
@AssigDataModel(Model)
<!--inject-->
<div class="barticledetail">

    <div class="barticledetail-back">
        @{
            if (articleData == null)
            {
                articleData = new ArticleLimpet(new SimplisityInfo()); // stop error when no id
            }
            var hreflink2 = ListUrl(moduleData.ListPageTabId(), categoryData);
        }
        <a href="@(hreflink2)" class="bigbutton"><i class="fas fa-angle-left"></i>@ResourceKey("RocketBusinessAPI.back", sessionParams.CultureCode)</a>
    </div>

    <div class="barticledetailflex">

        <div class="barticledetail-left">

            <figure class="image">
                <img id="mainimage@(articleData.ArticleId)" src="@ImageUrl(articleData.GetImage(0).RelPath,640,-1)" alt="@articleData.GetImage(0).Alt" />
            </figure>

            <h1 class="title">@articleData.Name</h1>
            @if (articleData.GetProperties().Count > 0)
            {
                <p class="subtitle">@articleData.GetProperties().First().Name</p>
            }
            <div class="barticledetail-section">@HtmlOf(articleData.RichText)</div>

            @if (articleData.GetImages().Count > 1)
            {
            <div class="barticledetail-section barticlegallery">
                @{var imgLp = 1;}
                @foreach (var i in articleData.GetImages())
                {
                <a data-fancybox="gallery" data-caption="@(i.Alt)" href="@ImageUrl(i.RelPath,800,0)">
                <img src="@ImageUrl(i.RelPath,150,150)" alt="@(i.Alt)" />
                </a>
                }
            </div>
            }

            <div class="barticledetail-section">
                @if ((articleData.Info.GetXmlProperty("genxml/textbox/lat") != "") && (articleData.Info.GetXmlProperty("genxml/textbox/long") != "" ))
                {
                <div class="h3-headline"><i class="fas fa-map-marker-alt"></i>@ResourceKey("RocketBusinessAPI.localize", sessionParams.CultureCode)</div>
                <div id="leafletmap"></div>
                }
            </div>

        </div>

        <div class="barticledetail-right">

            [INJECT:apptheme,OpenTimes.cshtml]

             <div class="barticledetail-section">
                <div class="h3-headline"><i class="far fa-user-circle"></i>@ResourceKey("RocketBusinessAPI.contact", sessionParams.CultureCode)</div>
                <div class="block">
                    <h4>@articleData.Name</h4>
                    @articleData.Info.GetXmlProperty("genxml/textbox/address1")
                    @if (articleData.Info.GetXmlProperty("genxml/textbox/address2") != "")
                    {
                        <br />@articleData.Info.GetXmlProperty("genxml/textbox/address2")
                    }
                    @if (articleData.Info.GetXmlProperty("genxml/textbox/address2") != "")
                    {
                        <br />@articleData.Info.GetXmlProperty("genxml/textbox/address3")
                    }
                    @if (articleData.Info.GetXmlProperty("genxml/textbox/address4") != "")
                    {
                        <br />@articleData.Info.GetXmlProperty("genxml/textbox/address4")
                    }
                    
                </div>

                @if (articleData.Info.GetXmlProperty("genxml/textbox/phone") != "")
                {
                    <div class="block h4-headline">@ResourceKey("RocketBusinessAPI.tel", sessionParams.CultureCode) @articleData.Info.GetXmlProperty("genxml/textbox/phone")</div>
                }
                @if (articleData.Info.GetXmlProperty("genxml/textbox/mobile") != "")
                {
                    <div class="block h4-headline">@ResourceKey("RocketBusinessAPI.mobile", sessionParams.CultureCode) @articleData.Info.GetXmlProperty("genxml/textbox/mobile")</div>
                }

                @if (articleData.Info.GetXmlProperty("genxml/textbox/email") != "")
                {
                    <div class="block">@ResourceKey("RocketBusinessAPI.email", sessionParams.CultureCode) : @EmailOf(articleData.Info, "genxml/textbox/email")</div>
                }

                @if (articleData.Info.GetXmlProperty("genxml/textbox/website") != "")
                {
                    var websiteUrl = articleData.Info.GetXmlProperty("genxml/textbox/website");
                    if (!websiteUrl.StartsWith("http"))
                    {
                        websiteUrl = "http://" + websiteUrl;
                    }
                    <div class="block"><a href="@websiteUrl")" target="_blank" class="bigbutton">@ResourceKey("RocketBusinessAPI.website", sessionParams.CultureCode)</a></div>
                }

                 <div class="barticledetail-section sociallinks">
                    @LinkURL(info, "genxml/textbox/facebooklink", true, "<i class='fab fa-facebook fa-2x'></i>", " target='_blank' ")
                    @LinkURL(info, "genxml/textbox/instagramlink", true, "<i class='fab fa-instagram fa-2x'></i>", " target='_blank' ")
                    @LinkURL(info, "genxml/textbox/youtubelink", true, "<i class='fab fa-youtube fa-2x'></i>", " target='_blank' ")
                    @LinkURL(info, "genxml/textbox/twitterlink", true, "<i class='fab fa-twitter fa-2x'></i>", " target='_blank' ")
                    @LinkURL(info, "genxml/textbox/linkedinlink", true, "<i class='fab fa-linkedin fa-2x'></i>", " target='_blank' ")
                </div>
            </div>

            @if (articleData.Getlinks().Count > 0 || articleData.GetDocs().Count > 0)
            {
                <div class="barticledetail-section docslinks" id="linklistcontainer">
                    <div class="h3-headline">@ResourceKey("DNNrocket.links") / @ResourceKey("DNNrocket.documents")</div>
                    @foreach (var lk in articleData.Getlinks())
                    {
                        if (!lk.Hidden)
                        {
                            var lkName = lk.Name;
                            if (lkName == "")
                            {
                                lkName = lk.Url;
                            }
                            <a target="_blank" href="@lk.Url" class="panel-block">
                                <i class="fas fa-link" aria-hidden="true"></i>@lkName
                            </a>
                        }
                    }
                    @foreach (var doc in articleData.GetDocs())
                    {
                        if (!doc.Hidden)
                        {
                            <a target="_blank" href="@doc.RelPath" class="panel-block">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i>@doc.Name
                            </a>
                        }
                    }
                </div>
            }

        </div>

    </div>

</div>

<script>
    $(document).ready(function () {

    @if ((articleData.Info.GetXmlProperty("genxml/textbox/lat") != "") && (articleData.Info.GetXmlProperty("genxml/textbox/long") != ""))
    {
        <text>
            setTimeout(() => { initmap(); }, 500);
        </text>
    }

        function initmap() {
            var x = '@articleData.Info.GetXmlProperty("genxml/textbox/lat")';
            var y = '@articleData.Info.GetXmlProperty("genxml/textbox/long")';
            var defaultLat = '@moduleData.Record.GetXmlProperty("genxml/settings/lat")';
            var defaultLong = '@moduleData.Record.GetXmlProperty("genxml/settings/long")';
            var companyname = '@articleData.Info.GetXmlProperty("genxml/textbox/companyname")';
            var marker = "";
            var map = "";
            var defaultIcon = L.icon({
                iconUrl: '/@(appTheme.AppThemeVersionFolderRel.TrimStart('/'))/img/marker-default.png',
                iconSize: [27, 36],
                iconAnchor: [13, 36]
            });

            map = L.map('leafletmap', { minZoom: 3, scrollWheelZoom: false }).setView([x, y], 16);
            marker = L.marker([x, y], {
                title: companyname,
                icon: defaultIcon
            });
            map.addLayer(marker);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
        }

    });

    $("[data-fancybox]").fancybox({
    lang : 'fr',
    i18n : {
        'fr' : {
            CLOSE       : 'Fermer',
            NEXT        : 'Suivant',
            PREV        : 'Précédent',
            ERROR       : 'Le contenu demandé ne peut pas être chargé.<br />Veuillez réessayer plus tard.',
            PLAY_START  : 'Démarrer le diaporama',
            PLAY_STOP   : 'Mettre en pause le diaporama',
            FULL_SCREEN : 'Plein écran',
            THUMBS      : 'Vignettes',
            DOWNLOAD    : 'Télécharger',
            SHARE       : 'Partager',
            ZOOM        : 'Zoomer'
        }
    }
    });

</script>
