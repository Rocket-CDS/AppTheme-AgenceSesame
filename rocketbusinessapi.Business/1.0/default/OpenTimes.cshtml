@inherits RocketBusinessAPI.Components.RocketBusinessAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using RocketBusinessAPI.Components;
@using RocketPortal.Components;
@using System.Globalization;
@AssigDataModel(Model)
<!--inject-->
@{
    var opentimes = RocketBusinessUtils.OpeningHours(articleData);
    int[] openarray = { 1, 2, 3, 4, 5, 6, 0 }; 
}
@if (opentimes.Count > 0)
{
    <div class="articledetail-section">
        <div class="h3-headline"><i class="far fa-clock"></i>@ResourceKey("RocketBusinessAPI.openinghours", sessionParams.CultureCode)</div>
        <table class="pdr-table">
        <tbody>
        @foreach (var dl in openarray)
        {
            var o1 = opentimes[dl][0];
            var c1 = opentimes[dl][1];
            var o2 = opentimes[dl][2];
            var c2 = opentimes[dl][3];
            <tr>
                <th>@DateTime.MinValue.AddDays(dl + 6).ToString("dddd")</th>
                @if (o1 != "" && o2 != "" && c1 != "" && c2 != "")
                {
                    <td>@o1-@c1</td>
                    <td>@o2-@c2</td>
                }
                else if (o1 != "" && c1 != "" && o2 == "" && c2 == "")
                {
                    <td>@o1-@c1</td>
                    <td>@ResourceKey("RocketBusinessAPI.closed")</td>
                }
                else if (o2 != "" && c2 != "" && o1 == "" && c1 == "")
                {
                    <td>@ResourceKey("RocketBusinessAPI.closed")</td>
                    <td>@o2-@c2</td>
                }
                else if (o1 != "" && c2 != "" && c1 == "" && o2 == "")
                {
                    <td colspan="2" align="center">@o1-@c2</td>
                }
                else
                {
                    <td colspan="2" align="center">@ResourceKey("RocketBusinessAPI.closed")</td>
                }
            </tr>
        }
        </tbody>
        </table>
    </div>
}
