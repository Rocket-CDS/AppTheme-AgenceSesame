@inherits RocketBusinessAPI.Components.RocketBusinessAPITokens<Simplisity.SimplisityRazor>
@using RocketDirectoryAPI.Components;
@using DNNrocketAPI;
@using Simplisity;
@using RocketPortal.Components;
@using DNNrocketAPI.Components;
@using System.Globalization;
@using Rocket.AppThemes.Components;
@AssignDataModel(Model)
<!--inject-->

@RenderLanguageSelector("articleadmin_editlist", new Dictionary<string, string>(), appThemeDirectory, Model)

<div class='w3-animate-opacity'>

    [INJECT:appthemedirectory,AdminSearch.cshtml]

    <div id="datalistsection" class="w3-padding">

        <table class="w3-table w3-bordered w3-hoverable">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                    <th>@ResourceKey("DNNrocket.name")</th>
                </tr>
            </thead>
            @foreach (ArticleLimpet articleData in articleDataList.GetArticleList())
            {
                <tr class=" simplisity_click" s-cmd="articleadmin_editarticle" s-fields='{"articleid":"@articleData.ArticleId","track":"true"}' style="cursor:pointer;">
                    <td style="width:54px;">
                        @if (articleData.IsHidden)
                        {
                            <span class="material-icons">
                                hide_source
                            </span>
                        }
                    </td>
                    <td style="width:54px;">
                        @if (articleData.GetImage(0) != null && articleData.GetImage(0).RelPath != "")
                        {
                            <img src="@ThumbnailImageUrl(articleData.GetImage(0).RelPath, 48, 48)" style="height:48px;width:48px;" class="w3-round" />
                        }
                        else
                        {
                            <img src="@ThumbnailImageUrl("/DesktopModules/DNNrocket/api/images/noimage2.png", 48, 48)" style="height:48px;width:48px;" class="w3-round" />
                        }

                    </td>
                    <td><div class="w3-tiny">@articleData.Ref</div><b>@articleData.Name</b></td>
                </tr>
            }
        </table>

        [INJECT:appthemedirectory,AdminPaging.cshtml]

    </div>

</div>

<script>
    $(document).ready(function () {

    });
</script>
