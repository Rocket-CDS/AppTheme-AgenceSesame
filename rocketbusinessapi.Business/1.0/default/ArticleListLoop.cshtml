@inherits RocketBusinessAPI.Components.RocketBusinessAPITokens<Simplisity.SimplisityRazor>
@using DNNrocketAPI;
@using Simplisity;
@using DNNrocketAPI.Components;
@using RocketDirectoryAPI.Components;
@using RocketBusinessAPI.Components;
@AssigDataModel(Model)
<!--inject-->

<div class="listcontainer">

<div class="barticlelist">

    @foreach (ArticleLimpet articleData2 in articleDataList.GetArticleList())
    {
        var hreflink = DetailUrl(moduleData.DetailPageTabId(), articleData2, categoryData);
        <div class="barticle">
            <figure class="barticle-image">
                <a href="@hreflink" onclick="$('.simplisity_loader').show()">
                    <img src="@ImageUrl(articleData2.GetImage(0).RelPath,380, 0)" alt="@articleData2.Name">
                </a>
            </figure>
            <div class="barticle-content">
                <h2><a href="@(hreflink)" onclick="$('#simplisity_loader').show();">@articleData2.Name</a></h2>
                <div class="barticle-summary">
                    @articleData2.Info.GetXmlProperty("genxml/textbox/address1")
                    @if (articleData2.Info.GetXmlProperty("genxml/textbox/address2") != "")
                    {
                        <br /><span>@articleData2.Info.GetXmlProperty("genxml/textbox/address2")</span>}
                    @if (articleData2.Info.GetXmlProperty("genxml/textbox/address3") != "")
                    {
                        <br /><span>@articleData2.Info.GetXmlProperty("genxml/textbox/address3")</span>}
                    @if (articleData2.Info.GetXmlProperty("genxml/textbox/address4") != "")
                    {
                        <br /><span>@articleData2.Info.GetXmlProperty("genxml/textbox/address4")</span>}
                </div>
            </div>
        </div>
    }
    
</div>

<div class="paging">
    [INJECT:apptheme,ArticlePaging.cshtml]
</div>

</div>